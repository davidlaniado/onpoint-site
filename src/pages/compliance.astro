---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTASimple from '../components/CTASimple.astro';
import Molecule from '../components/Molecule.astro';
import ReviewPass from '../components/viz/ReviewPass.astro';
const faq = [
  { q: 'Who owns the health claims?', a: 'The brand. Every offer ships with a claim set the brand has approved. OnPoint reviews creative against it for advertising standards, and the claims stay in the brand’s words.' },
  { q: 'What does partner verification cover?', a: 'Identity, business, and traffic source, before a partner sees an offer. Channels and placements are approved per offer.' },
  { q: 'What happens when an ad is flagged?', a: 'It goes back to the partner with the reason. Once revised and cleared, it is logged with a reviewer and a time. Consistent quality earns higher caps.' },
  { q: 'Does OnPoint handle patient data?', a: 'OnPoint runs on advertising and performance events only. Protected health information stays with the brand and its providers.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Compliance" description="How compliance works at OnPoint: brand-owned claims, verified partners, creative reviewed before it runs, and real-time tracking." jsonLd={faqLd}>
  <PageHero kicker="Compliance, built in" title="Telehealth is regulated. <span class='text-teal-ink'>We build for that.</span>" lead="Compliance at OnPoint is a layer that runs under every launch, so brands can scale through partners with confidence and partners can build on offers that last." narrow />

  <section class="container-x pt-16 md:pt-24">
    <div class="grid md:grid-cols-2 gap-5">
      {[
        ['Claims stay with the brand', 'Every offer ships with a claim set the brand approved. Creative is reviewed against it, in the brand’s own words.'],
        ['Partners are verified first', 'Identity, business, and traffic source are checked before a partner sees an offer. Channels and placements are approved per offer.'],
        ['Creative is reviewed before it runs', 'Ads and landing pages are checked before launch and as partners add new angles. Flags go back with the reason; passes are logged.'],
        ['Tracking both sides can trust', 'Every charged order is tracked in real time, reversals come with a reason, and the brand and partner share one conversion log.'],
      ].map(([t, d]) => (
        <div class="rounded-[24px] bg-paper p-7 md:p-9 reveal"><h3 class="text-xl font-bold">{t}</h3><p class="mt-2 text-[15px] text-slate leading-relaxed">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="mt-20 md:mt-28 bg-navy-deep text-white">
    <div class="container-x py-16 md:py-24 grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-center">
      <div>
        <p class="kicker kicker-light">The review, in practice</p>
        <h2 class="h2 text-white mt-3">What a creative review looks like.</h2>
        <p class="text-white/75 text-lg mt-4 leading-relaxed">A partner submits an ad. It is checked line by line against the brand’s claim set, the landing page, the traffic source, and the placement. Anything outside the set goes back with the reason. The revised ad clears and is logged with a reviewer and a time.</p>
      </div>
      <Molecule class="reveal" />
    </div>
    <div class="container-x pb-16 md:pb-24"><div class="review-shell reveal"><ReviewPass /></div></div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10">
      <div><h2 class="h2">Questions, answered.</h2></div>
      <FAQ items={faq} />
    </div>
  </section>

  <CTASimple />
</Base>
