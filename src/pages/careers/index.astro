---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { href, SITE } from '../../lib/site';
const jobs = (await getCollection('jobs', ({ data }) => data.open)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Careers" description="Open roles at OnPoint Health Media & Tech. Small, senior, founder-led team in telehealth performance marketing.">
  <PageHero kicker="Careers" title="Own a lane. <span class='text-teal-ink'>See it in the numbers.</span>" lead="We run a small team with big mandates. Everyone works with real ownership, direct access to the founders, and AI-native workflows that multiply what one person can ship." narrow />

  <section class="container-x pt-16 md:pt-24">
    <div class="grid md:grid-cols-3 gap-5">
      {[
        ['Founder-led', 'You work directly with the people who built the playbook, not three layers below them.'],
        ['AI-native', 'Claude Code, AI video, AI voice. We train you to build your own workflows so you can produce more, faster.'],
        ['Paid on results', 'Commission and bonus structures tied to the numbers you actually move.'],
      ].map(([t, d]) => (
        <div class="rounded-[24px] bg-paper p-7 reveal"><h3 class="text-lg font-bold">{t}</h3><p class="mt-2 text-[15px] text-slate leading-relaxed">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <h2 class="h2">{jobs.length} open {jobs.length === 1 ? 'role' : 'roles'}</h2>
    <div class="mt-8 grid gap-4">
      {jobs.map((j) => (
        <a href={href(`/careers/${j.id}/`)} class="rounded-[24px] border border-line p-6 md:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-teal transition-colors reveal">
          <div>
            <h3 class="text-xl font-bold">{j.data.title}</h3>
            <p class="mt-1 text-[15px] text-slate max-w-2xl">{j.data.summary}</p>
          </div>
          <div class="shrink-0 text-sm text-mist sm:text-right"><p>{j.data.department} · {j.data.type}</p><p>{j.data.location}</p></div>
        </a>
      ))}
    </div>
    <p class="mt-8 text-slate">Looking for a different role? Strong media buyers, creative strategists, and affiliate managers can always email <a class="underline text-navy font-semibold" href={`mailto:${SITE.careersEmail}`}>{SITE.careersEmail}</a> with a short note on the biggest thing you have scaled.</p>
  </section>
</Base>
