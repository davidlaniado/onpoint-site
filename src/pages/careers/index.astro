---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';
import { href, SITE } from '../../lib/site';
import Photo from '../../components/Photo.astro';
const jobs = (await getCollection('jobs', ({ data }) => data.open)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Careers" description="Open roles at OnPoint Health Media & Tech. Small, senior, founder-led team in telehealth performance marketing.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-x relative pt-14 pb-12 md:pt-24 md:pb-16 grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-center">
    <div>
      <p class="eyebrow">Careers</p>
      <h1 class="mt-5 text-[36px] sm:text-[46px] lg:text-[54px] leading-[1.08] font-extrabold">Own a lane. <span class="text-teal-ink">See it in the numbers.</span></h1>
      <p class="mt-6 text-lg md:text-xl text-slate leading-relaxed">We run a small team with big mandates. Everyone works with real ownership, direct access to the founders, and AI-native workflows that multiply what one person can ship. If you want your work to move the numbers the same week you do it, read on.</p>
    </div>
    <div class="reveal rounded-3xl overflow-hidden aspect-[3/2]"><Photo name="careers-hero" alt="A team member working from a bright home office" width="2000" height="1344" eager /></div>
    </div>
  </section>

  <section class="container-x">
    <div class="grid md:grid-cols-3 gap-4">
      {[
        ['Founder-led', 'You work directly with the people who built the playbook, not three layers below them.'],
        ['AI-native', 'Claude Code, AI video, AI voice. We train you to build your own workflows so you can produce more, faster.'],
        ['Paid on results', 'Commission and bonus structures tied to the numbers you actually move.'],
      ].map(([t, d]) => (
        <div class="card p-6 reveal"><p class="font-display font-bold text-navy">{t}</p><p class="mt-2 text-sm text-slate leading-relaxed">{d}</p></div>
      ))}
    </div>
  </section>

  <Section eyebrow="Open roles" title={`${jobs.length} open ${jobs.length === 1 ? 'role' : 'roles'}`}>
    <div class="divide-y divide-line border-y border-line">
      {jobs.map((j) => (
        <a href={href(`/careers/${j.id}/`)} class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-6 py-5 group">
          <div>
            <p class="font-display font-bold text-lg text-navy group-hover:text-teal-ink">{j.data.title}</p>
            <p class="mt-1 text-sm text-slate max-w-2xl">{j.data.summary}</p>
          </div>
          <div class="shrink-0 text-sm text-mist sm:text-right">
            <p>{j.data.department} · {j.data.type}</p>
            <p>{j.data.location}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-8 text-slate">Do not see your role? Strong media buyers, creative strategists, and affiliate managers can always email <a class="underline text-navy" href={`mailto:${SITE.careersEmail}`}>{SITE.careersEmail}</a> with a short note on the biggest thing you have scaled.</p>
  </Section>
</Base>
