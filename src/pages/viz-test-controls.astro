---
import Base from '../layouts/Base.astro';
import OfferControls from '../components/viz/OfferControls.astro';
import PartnerDesk from '../components/viz/PartnerDesk.astro';
import OfferSheet from '../components/viz/OfferSheet.astro';
import StagePipeline from '../components/viz/StagePipeline.astro';
import '../styles/viz-controls.css';
const verts = ['glp1', 'trt', 'ed', 'hair', 'hrt', 'dx'] as const;
---
<Base title="viz test controls" noindex>
  <div class="container-x py-12 grid gap-10">
    <div class="grid md:grid-cols-2 gap-6">
      <div><p class="mono-label mb-3">OfferControls</p><OfferControls /></div>
      <div><p class="mono-label mb-3">PartnerDesk</p><PartnerDesk /></div>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <div><p class="mono-label mb-3">OfferControls compact</p><OfferControls compact /></div>
      <div><p class="mono-label mb-3">PartnerDesk compact</p><PartnerDesk compact /></div>
    </div>
    <div><p class="mono-label mb-3">OfferSheet full</p><div class="max-w-md"><OfferSheet vertical="glp1" /></div></div>
    <div><p class="mono-label mb-3">OfferSheet compact grid</p><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{verts.map((v) => <OfferSheet vertical={v} compact />)}</div></div>
    <div class="grid md:grid-cols-2 gap-6">
      <div><p class="mono-label mb-3">StagePipeline brands</p><StagePipeline side="brands" /></div>
      <div class="band-dark rounded-3xl p-6"><p class="mono-label mb-3">StagePipeline in dark band</p><StagePipeline side="partners" /></div>
    </div>
  </div>
</Base>
