---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatStrip from '../components/StatStrip.astro';
import Section from '../components/Section.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import DarkBand from '../components/DarkBand.astro';
import OfferControls from '../components/viz/OfferControls.astro';
import PartnerDesk from '../components/viz/PartnerDesk.astro';
import ReviewPass from '../components/viz/ReviewPass.astro';
import { href, SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const verticals = (await getCollection('programs')).filter((p) => p.data.group === 'vertical').sort((a, b) => a.data.order - b.data.order);
const faq = [
  { q: 'What is OnPoint?', a: 'A gated performance network for telehealth, wellness, and diagnostics brands. We connect brands with identity-verified media partners, run server-side tracking and payouts between them, and review ads and funnels before launch. Brands keep full control of their health claims.' },
  { q: 'Who owns the health claims?', a: 'The brand. OnPoint reviews creative against the brand’s approved claim set for advertising standards. We never write, change, or substantiate a medical claim.' },
  { q: 'How are partners paid?', a: 'On approved performance under terms agreed before launch: CPA, revenue share, or hybrid depending on the offer. Reversals show up with a reason.' },
  { q: 'How do I get started?', a: 'Apply through the contact page as a brand or a partner. Every application is reviewed for compliance readiness and fit before anything goes live.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="OnPoint Health Media & Tech | Compliant scale for telehealth brands" description={SITE.description} jsonLd={faqLd}>
  <Hero />
  <StatStrip />

  <Section eyebrow="Two sides, one standard" title="Not an agency. A network with a compliance arm." lead="Brands bring a program that already converts. Partners bring verified traffic. OnPoint is the gate, the tracking, and the payout between them.">
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="card overflow-hidden reveal">
        <div class="p-5 pb-0"><OfferControls compact /></div>
        <div class="p-6 md:p-8">
          <p class="mono-label">For brands</p>
          <h3 class="mt-2 text-2xl font-extrabold leading-tight">Scale through partners without losing control.</h3>
          <ul class="mt-4 space-y-2 text-[15px] text-slate">
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>Your claim set. Ads and funnels reviewed against it before launch.</li>
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>Only verified partners on the channels you allow.</li>
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>Attribution and payments visible end to end.</li>
          </ul>
          <a href={href('/brands/')} class="btn btn-primary mt-6">For brands →</a>
        </div>
      </div>
      <div class="card overflow-hidden reveal">
        <div class="p-5 pb-0"><PartnerDesk compact /></div>
        <div class="p-6 md:p-8">
          <p class="mono-label">For media partners</p>
          <h3 class="mt-2 text-2xl font-extrabold leading-tight">Exclusive offers that pay and stay.</h3>
          <ul class="mt-4 space-y-2 text-[15px] text-slate">
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>Exclusive telehealth offers with clear claim rules per offer.</li>
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>One tracking link, server-side postbacks, sub IDs to the ad.</li>
            <li class="flex gap-3"><span class="text-teal-ink">✓</span>Paid on approved performance. Reversals explained.</li>
          </ul>
          <a href={href('/partners/')} class="btn btn-ghost mt-6">For partners →</a>
        </div>
      </div>
    </div>
  </Section>

  <Section eyebrow="How it works" title="Apply, verify, live, cleared." lead="Both sides go through the gate. Nothing runs before verification.">
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        ['Apply', 'Brands: business and compliance review. Partners: identity, KYC, and traffic source.'],
        ['Verify', 'Claim set and terms locked for the brand. Channels and placements approved for the partner.'],
        ['Go live', 'Verified partners only, on approved channels, with a tracking test passed first.'],
        ['Get paid', 'Payouts on approved performance. Reversals shown with a reason. Same numbers on both sides.'],
      ].map(([t, d], i) => (
        <li class="card p-6 reveal">
          <p class="text-sm font-semibold text-teal-ink">{i + 1}</p>
          <h3 class="mt-1 text-lg font-bold">{t}</h3>
          <p class="mt-2 text-[15px] text-slate leading-relaxed">{d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <DarkBand class="!my-12 md:!my-16">
    <Section eyebrow="Compliance" title="Reviewed before it runs. Every time." lead="Creative is checked against the brand’s claim set. What fails goes back to the partner. What passes is logged with a reviewer and a time." class="!py-10 md:!py-14">
      <div class="reveal"><ReviewPass /></div>
      <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-[14px]">
        {['Brand-owned, brand-approved claims', 'Identity, KYC, and traffic-source verification', 'Server-side tracking through Everflow', 'Sources removed when quality drops'].map((t) => (
          <li class="flex items-start gap-2 text-white/85 reveal"><span class="mt-2 w-1.5 h-1.5 rounded-full bg-teal shrink-0"></span>{t}</li>
        ))}
      </ul>
    </Section>
  </DarkBand>

  <Section eyebrow="Where we work" title="Six regulated categories." lead="Each program page has the payable event, allowed channels, and the claim rules." class="!py-10 md:!py-14">
    <div class="flex flex-wrap gap-3">
      {verticals.map((p) => (
        <a href={href(`/programs/${p.id}/`)} class="reveal card card-hover px-4 py-3 font-display font-bold text-navy text-[15px] flex items-center gap-2">{p.data.title.replace(' Affiliate Program', '').replace(' and Lab Testing', '')} <span class="text-teal-ink" aria-hidden="true">→</span></a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Questions" title="Straight answers." class="!py-10 md:!py-14">
    <div class="max-w-3xl"><FAQ items={faq} /></div>
  </Section>

  <CTABand />
</Base>
