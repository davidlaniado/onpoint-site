---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { href } from '../../lib/site';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const aud: Record<string, string> = { brands: 'For brands', partners: 'For partners', both: 'Brands + partners' };
---
<Base title="Blog" description="Plain-English notes on telehealth affiliate marketing, compliant traffic, tracking, and payouts. Written by operators who run it daily.">
  <PageHero kicker="The OnPoint blog" title="Notes from inside <span class='text-teal'>regulated health acquisition.</span>" lead="How telehealth offers, tracking, compliance, and payouts actually work. Short, plain English, written by people who run this every day." narrow />
  <section class="container-x pt-16 md:pt-20 pb-6">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map((p) => (
        <a href={href(`/blog/${p.id}/`)} class="rounded-[24px] border border-line p-7 block hover:border-teal transition-colors reveal">
          <div class="flex items-center justify-between gap-3 text-xs"><span class="text-mist">{fmt(p.data.pubDate)}</span><span class="font-semibold text-teal-ink bg-teal-soft px-2.5 py-1 rounded-full">{aud[p.data.audience]}</span></div>
          <h2 class="mt-4 text-xl font-bold leading-snug">{p.data.title}</h2>
          <p class="mt-2 text-[15px] text-slate leading-relaxed">{p.data.description}</p>
          <p class="mt-5 text-sm font-semibold text-teal-ink">Read the article</p>
        </a>
      ))}
    </div>
  </section>
</Base>
