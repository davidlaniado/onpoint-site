---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';
import CTASimple from '../../components/CTASimple.astro';
import { getCollection, render } from 'astro:content';
import { href, SITE } from '../../lib/site';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const url = new URL(Astro.url.pathname, Astro.site).toString();
const ld: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL(href('/img/logo-2x.png'), Astro.site).toString() } },
  mainEntityOfPage: url,
}];
if (d.faq.length) ld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const related = (await getCollection('blog', ({ data, id }) => !data.draft && id !== post.id)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const relatedPrograms = d.related.length ? (await getCollection('programs')).filter((p) => d.related.includes(p.id)) : [];
---
<Base title={d.title} description={d.description} type="article" jsonLd={ld}>
  <section class="hero-navy text-white">
    <div class="container-x py-12 md:py-16 max-w-4xl">
      <a href={href('/blog/')} class="text-sm text-white/60 hover:text-white">All articles</a>
      <p class="mt-6 text-teal font-semibold text-sm">{fmt(d.pubDate)} · {d.author}</p>
      <h1 class="mt-3 text-white text-[32px] md:text-[46px] leading-[1.08] font-extrabold tracking-[-0.02em]">{d.title}</h1>
      <p class="mt-5 text-lg md:text-xl text-white/80 leading-relaxed">{d.description}</p>
      {d.quickAnswer && <div class="mt-7 rounded-[20px] bg-white/10 border border-white/15 p-5 md:p-6"><p class="text-teal font-semibold text-sm mb-1">Quick answer</p><p class="text-white/90 text-[17px] leading-relaxed">{d.quickAnswer}</p></div>}
    </div>
  </section>
  <article class="container-x pt-12 md:pt-16">
    <div class="max-w-3xl mx-auto">
      <div class="prose-op"><Content /></div>
      {d.faq.length > 0 && (
        <section class="mt-12">
          <h2 class="h2 !text-[30px] mb-5">Quick answers</h2>
          <FAQ items={d.faq} />
        </section>
      )}
      {relatedPrograms.length > 0 && (
        <section class="mt-12">
          <p class="kicker mb-3">Related programs</p>
          <ul class="grid sm:grid-cols-2 gap-3">
            {relatedPrograms.map((p) => <li><a href={href(`/programs/${p.id}/`)} class="block rounded-[16px] border border-line p-4 text-navy font-semibold text-[15px] hover:border-teal transition-colors">{p.data.title}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </article>
  {related.length > 0 && (
    <section class="container-x pt-16 md:pt-20">
      <p class="kicker">Keep reading</p>
      <div class="mt-5 grid md:grid-cols-3 gap-5">
        {related.map((p) => (
          <a href={href(`/blog/${p.id}/`)} class="rounded-[20px] border border-line p-6 block hover:border-teal transition-colors">
            <h3 class="text-lg font-bold leading-snug">{p.data.title}</h3>
            <p class="mt-2 text-sm text-slate leading-relaxed">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  <CTASimple />
</Base>
