---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../lib/site';
---
<Base title="Contact" description="Talk to OnPoint. Brands and media partners: tell us what you are trying to grow and a real person will get back to you.">
  <section class="hero-light">
    <div class="container-x py-14 md:py-20 grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <div>
        <p class="text-teal-ink font-semibold text-sm md:text-[15px]">Contact</p>
        <h1 class="mt-4 text-navy text-[38px] leading-[1.05] sm:text-[48px] lg:text-[56px] font-extrabold tracking-[-0.02em]">Tell us what you are <span class="text-teal-ink">trying to grow.</span></h1>
        <p class="mt-6 text-lg text-slate leading-relaxed max-w-xl">Brands, media partners, and future teammates. A real person reads every message and replies within one business day.</p>
        <ul class="mt-8 space-y-3 text-slate">
          <li><span class="text-mist">Email </span><a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><span class="text-mist">Legal </span><a class="underline" href={`mailto:${SITE.legalEmail}`}>{SITE.legalEmail}</a></li>
          <li><span class="text-mist">Based in </span>the New York metro. Partners everywhere.</li>
        </ul>
      </div>
      <div class="hero-form hero-form-light"><p class="text-navy font-bold text-lg mb-1">Talk to us</p><p class="text-slate text-sm mb-4">A real person replies within one business day.</p><ContactForm bare /></div>
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28 text-center pb-6">
    <h2 class="h2">What happens after you apply.</h2>
    <div class="mt-12 grid sm:grid-cols-3 gap-8 md:gap-6 max-w-4xl mx-auto">
      {[
        ['Verification', 'Both sides are checked before anything is shown or sent. Brands: business and compliance. Partners: identity, KYC, and traffic source.'],
        ['Offer and terms', 'Claim set, channels, cap, and structure, agreed in writing. A tracking test before any spend.'],
        ['Live with partners', 'Verified partners on approved channels. Same numbers on both sides. Paid on approved performance.'],
      ].map(([t, d], i) => (
        <div class="reveal"><span class="step-circle">{i + 1}</span><h3 class="mt-4 text-xl font-bold">{t}</h3><p class="mt-2 text-[15px] text-slate leading-relaxed">{d}</p></div>
      ))}
    </div>
  </section>
</Base>
