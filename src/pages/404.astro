---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---
<Base title="Page not found" noindex>
  <section class="container-x py-24 text-center max-w-xl mx-auto">
    <p class="mono-label">404</p>
    <h1 class="mt-4 text-4xl font-extrabold">That page is not here.</h1>
    <p class="mt-4 text-slate">It may have moved, or the link was wrong. Head back home or reach out and we will point you the right way.</p>
    <div class="mt-8 flex justify-center gap-3"><a href={href('/')} class="btn btn-primary">Home</a><a href={href('/contact/')} class="btn btn-ghost">Contact</a></div>
  </section>
</Base>
