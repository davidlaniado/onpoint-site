---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTASimple from '../components/CTASimple.astro';
import { href } from '../lib/site';
const faq = [
  { q: 'Who approves the health claims in my ads?', a: 'You do. Brands retain full ownership and approval authority over all health and medical claims. OnPoint reviews ads and funnels for advertising standards but does not create, modify, or substantiate clinical claims.' },
  { q: 'Can I see which partners are running my offer?', a: 'Yes. Attribution is visible at the partner and channel level. Only verified partners on approved channels and placements can run your offer.' },
  { q: 'What commercial structures do you support?', a: 'CPA, revenue share, and hybrid structures. Terms are agreed before launch and wired into tracking and payment logic from day one.' },
  { q: 'How fast can we launch?', a: 'It depends on verification and how ready your funnel and tracking are. Brands with a working funnel, LegitScript where required, and a clear offer can usually be live with partners within a couple of weeks.' },
  { q: 'Do you handle patient data?', a: 'No. OnPoint does not collect, store, or process protected health information. Tracking runs on advertising and performance events only.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="For Brands" description="Scale telehealth patient acquisition through verified partners with full control of your claims, your tracking, and your payouts." jsonLd={faqLd}>
  <PageHero kicker="For brands" title="Scale through partners <span class='text-teal-ink'>without losing control.</span>" lead="You keep ownership of your claims, your funnel, and your providers. Only verified partners run your offer, on the channels you allow. Attribution and payments are visible end to end." primary={['Apply as a brand', '/contact/?as=brand']} secondary={['See how it works', '#how']} pills={['Your claim set, enforced', 'Verified partners only', 'Paid on approved performance']} />

  <section class="container-x pt-20 md:pt-28">
    <p class="kicker">What you get</p>
    <h2 class="h2 mt-3 max-w-3xl">Compliant scale, with the controls in your hands.</h2>
    <div class="mt-10 grid md:grid-cols-2 gap-5">
      <div class="panel-mint reveal">
        <h3 class="text-2xl font-extrabold">You control</h3>
        <ul class="checks mt-6">
          <li>Every health claim. Ads and funnels are checked against your approved set before a dollar runs.</li>
          <li>Which channels, placements, and partners are allowed on your offer.</li>
          <li>The cap, the structure (CPA, revenue share, or hybrid), and the terms, all agreed before launch.</li>
          <li>Partner approvals. Approve or remove any partner at any time.</li>
        </ul>
      </div>
      <div class="panel-navy reveal">
        <h3 class="text-2xl font-extrabold text-white">OnPoint handles</h3>
        <ul class="checks checks-light mt-6">
          <li>Partner verification: identity, KYC, channel, and traffic source before access.</li>
          <li>Creative and funnel review against your claim set, before launch and as partners add angles.</li>
          <li>Server-side tracking through Everflow and Google Tag Manager, so you and the partner see the same sale.</li>
          <li>Payout reconciliation, reversals with a reason, and partner support so your team is not fielding tracking questions at 11pm.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="how" class="container-x pt-20 md:pt-28 text-center scroll-mt-24">
    <h2 class="h2">From intake to scale.</h2>
    <p class="lead mx-auto mt-4">Nothing runs before step four.</p>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-6">
      {[
        ['Verification', 'Business, credential, and compliance review.'],
        ['Offer intake', 'Your claim set, allowed channels, landing pages, and commercial terms, agreed in writing.'],
        ['Funnel and creative review', 'Entry points and approved creative structures checked against advertising standards.'],
        ['Tracking setup', 'Click ID through your funnel, server-to-server postback on the charge, reversal events on refunds. Tested before spend.'],
        ['Launch', 'Verified partners on approved channels only.'],
        ['Report and optimize', 'Partner-level attribution, funnel events, conversion rate optimization, and support as you add offers and markets.'],
      ].map(([t, d], i) => (
        <div class="reveal"><span class="step-circle">{i + 1}</span><h3 class="mt-4 text-xl font-bold">{t}</h3><p class="mt-2 text-[15px] text-slate leading-relaxed max-w-xs mx-auto">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10">
      <div><h2 class="h2">Questions brands ask first.</h2><p class="lead mt-4">Straight answers. The longer versions are on the program pages.</p></div>
      <FAQ items={faq} />
    </div>
  </section>

  <CTASimple title="Bring us your program." lead="Tell us the category, the funnel, and where you are stuck. We will tell you honestly whether we can help." primary={['Book a call', '/contact/?as=brand']} secondary={undefined} />
</Base>
