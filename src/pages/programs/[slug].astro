---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';
import CTASimple from '../../components/CTASimple.astro';
import { getCollection, render } from 'astro:content';
import { href, SITE } from '../../lib/site';
export async function getStaticPaths() {
  const all = await getCollection('programs');
  return all.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const all = await getCollection('programs');
const related = d.related.length ? all.filter((p) => d.related.includes(p.id)) : all.filter((p) => p.id !== page.id && p.data.group === d.group).slice(0, 4);
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.related.includes(page.id))).slice(0, 3);
const subject = d.group === 'vertical' ? d.title.replace(/\s+(Telehealth\s+)?Affiliate Program$/i, '').replace(/^At-Home Diagnostics and Lab Testing$/, 'At-Home Diagnostics') : d.group === 'channel' ? d.title.replace(/^Telehealth Offers for\s+/i, '').replace(/\s+(Media Buyers|Affiliates)$/i, '') : undefined;
const audienceLabel = { brands: 'For brands', partners: 'For media partners', both: 'For brands and partners' }[d.audience];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: d.title,
    description: d.description,
    url,
    dateModified: d.updated.toISOString().slice(0, 10),
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    about: { '@type': 'Service', name: d.title, provider: { '@type': 'Organization', name: SITE.name, url: SITE.url }, serviceType: d.group === 'channel' ? 'Affiliate program for media partners' : 'Telehealth performance marketing', areaServed: 'US', audience: { '@type': 'Audience', audienceType: audienceLabel } },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Programs', item: SITE.url + '/programs/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ] },
  ...(d.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={d.title} description={d.description} jsonLd={ld}>
  <section class="hero-navy text-white">
    <div class="container-x py-12 md:py-16">
      <nav class="text-sm text-white/60" aria-label="Breadcrumb"><a href={href('/')} class="hover:text-white">Home</a> <span aria-hidden="true">/</span> <a href={href('/programs/')} class="hover:text-white">Programs</a> <span aria-hidden="true">/</span> <span class="text-white">{d.title}</span></nav>
      <p class="mt-6 text-teal font-semibold text-sm md:text-[15px]">{audienceLabel}</p>
      <h1 class="mt-3 text-white text-[34px] sm:text-[44px] lg:text-[52px] leading-[1.06] font-extrabold tracking-[-0.02em] max-w-4xl" set:html={d.h1.replace(/text-teal-ink/g, 'text-teal')} />
      <div class="mt-8 max-w-3xl rounded-[20px] bg-white/10 border border-white/15 p-5 md:p-6"><p class="text-teal font-semibold text-sm mb-1">Quick answer</p><p class="text-white/90 text-[17px] leading-relaxed">{d.quickAnswer}</p></div>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={href(`/contact/?as=${d.audience === 'brands' ? 'brand' : 'partner'}`)} class="btn btn-teal">{d.audience === 'brands' ? 'Apply as a brand' : 'Apply as a partner'}</a>
        <a href="#faq" class="btn bg-white/10 text-white border border-white/25 hover:bg-white/15">Read the FAQ</a>
      </div>
    </div>
  </section>
  <article class="container-x pt-14 md:pt-20">
    <div class="max-w-3xl">
      <div class="prose-op"><Content /></div>
      {d.faq.length > 0 && (
        <section id="faq" class="mt-14 scroll-mt-24">
          <h2 class="h2 !text-[30px] mb-5">Frequently asked questions</h2>
          <FAQ items={d.faq} />
        </section>
      )}
      <p class="mt-8 text-xs text-mist">Last updated {d.updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}. {SITE.shortName} is a marketing platform, not a medical provider.</p>
    </div>
  </article>
  {(related.length > 0 || posts.length > 0) && (
    <section class="container-x pt-16 md:pt-20">
      <p class="kicker">Related</p>
      <div class="mt-5 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {related.map((p) => <a href={href(`/programs/${p.id}/`)} class="rounded-[20px] border border-line p-5 block hover:border-teal transition-colors"><p class="text-xs text-mist mb-2">Program</p><p class="font-bold text-navy leading-snug">{p.data.title}</p></a>)}
        {posts.map((p) => <a href={href(`/blog/${p.id}/`)} class="rounded-[20px] border border-line p-5 block hover:border-teal transition-colors"><p class="text-xs text-mist mb-2">Article</p><p class="font-bold text-navy leading-snug">{p.data.title}</p></a>)}
      </div>
    </section>
  )}
  <CTASimple />
</Base>
