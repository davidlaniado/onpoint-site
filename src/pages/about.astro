---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CTABand from '../components/CTABand.astro';
import { href } from '../lib/site';
const values = [
  ['Verify first', 'Nothing runs until both sides are checked. It is slower on day one and faster every day after.'],
  ['Numbers settle arguments', 'Same tracking, same events, same report for the brand and the partner. If it is not in the data, it did not happen.'],
  ['Brands own their claims', 'We review for advertising standards. We never write or change a medical claim. That line does not move.'],
  ['Speed with direction', 'Launch fast, read fast, kill losers fast, scale winners fast. Health advertising rewards operators who move and stay inside the lines.'],
  ['Small and senior', 'Founder-led. Every person here owns a lane and can see their impact in the numbers the same week.'],
  ['Say the hard thing', 'If an offer will not work, we say so. If a partner is off, they hear it from us before the brand does.'],
];
---
<Base title="About" description="OnPoint is a founder-led performance network for telehealth brands, built by operators who have driven over $1 billion in revenue for the brands they have scaled.">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-x relative pt-14 pb-12 md:pt-24 md:pb-20 max-w-3xl">
      <p class="eyebrow">About OnPoint</p>
      <h1 class="mt-5 text-[36px] sm:text-[46px] lg:text-[54px] leading-[1.08] font-extrabold">Operators first. <span class="text-teal-ink">Network second.</span></h1>
      <p class="mt-6 text-lg md:text-xl text-slate leading-relaxed">OnPoint was built by people who buy media, build funnels, and read the numbers every morning. We started it because health acquisition needed a network that takes the rules as seriously as the results.</p>
    </div>
  </section>

  <Section eyebrow="Who we are" title="A small team with a long track record.">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-8 items-start">
      <div class="prose-op reveal">
        <p>OnPoint Health Media & Tech is a performance platform for telehealth patient acquisition. We connect brands in metabolic health, hormone optimization, men's wellness, dermatology, and diagnostics with verified media partners, and we run the tracking, review, and payments in between.</p>
        <p>Before OnPoint, our founders built one of the largest performance marketing companies in the world: hundreds of team members across seven global offices, and over $1 billion in revenue driven for the brands they scaled. OnPoint is their next chapter, and it runs the same way. Small, senior, founder-led, and measured on results.</p>
        <p>We are also advertisers ourselves. We run our own telehealth campaigns every day, so when we tell a partner what converts or tell a brand what their funnel is leaking, it comes from live experience, not a slide deck.</p>
        <p>Our founders are members of the American Telemedicine Association. OnPoint operates with the same expectation of responsibility, transparency, and advertiser control.</p>
      </div>
      <div class="grid gap-4">
        {[
          ['$1B+', 'revenue driven for brands our founders have scaled'],
          ['7', 'global offices built at their last company'],
          ['Hundreds', 'of team members led before OnPoint'],
          ['5', 'regulated health categories supported today'],
        ].map(([n, l]) => (
          <div class="card p-5 reveal">
            <p class="font-display text-3xl font-extrabold text-navy">{n}</p>
            <p class="mt-1 text-sm text-slate">{l}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section eyebrow="Leadership" title="Three founders. Three lanes.">
    <div class="grid md:grid-cols-3 gap-5">
      {[
        ['Chief Executive Officer', 'Deal flow and advertiser relationships. Brings the offers in and keeps both sides aligned on terms.'],
        ['President', 'Technology, payments, and marketing infrastructure. Owns tracking, processing, and the systems everything runs on.'],
        ['Chief Growth Officer', 'Media buying and creative. Runs the campaigns, the creative engine, and the daily kill and scale calls.'],
      ].map(([t, d]) => (
        <div class="card p-6 reveal">
          <div class="w-12 h-12 rounded-full bg-teal-soft flex items-center justify-center text-teal-ink font-display font-bold">OP</div>
          <p class="mt-4 font-display font-bold text-navy">{t}</p>
          <p class="mt-2 text-sm text-slate leading-relaxed">{d}</p>
        </div>
      ))}
    </div>
    <p class="mt-5 text-sm text-mist">Find the team on <a class="underline" href="https://www.linkedin.com/company/onpoint-health-media" target="_blank" rel="noopener">LinkedIn</a>.</p>
  </Section>

  <Section eyebrow="How we work" title="Written for how we actually operate.">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {values.map(([t, d]) => (
        <div class="card p-6 reveal">
          <p class="font-display font-bold text-navy text-lg">{t}</p>
          <p class="mt-2 text-[15px] text-slate leading-relaxed">{d}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Where" title="Wyckoff, New Jersey. Partners everywhere.">
    <div class="card p-6 md:p-8 reveal grid sm:grid-cols-2 gap-6">
      <div>
        <p class="mono-label">Headquarters</p>
        <p class="mt-2 text-navy font-medium">OnPoint Health Media and Tech, Inc.</p>
        <p class="text-slate">291 Franklin Ave, Suite 7<br />Wyckoff, NJ 07481</p>
      </div>
      <div>
        <p class="mono-label">Reach us</p>
        <p class="mt-2 text-slate">Brands, partners, and candidates: <a class="underline text-navy" href={href('/contact/')}>contact page</a>.</p>
        <p class="mt-1 text-slate">Legal: <a class="underline text-navy" href="mailto:accounts@onpointhealthmedia.com">accounts@onpointhealthmedia.com</a></p>
      </div>
    </div>
  </Section>

  <CTABand />
</Base>
