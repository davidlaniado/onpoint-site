---
interface Props { words: string[] }
const { words } = Astro.props;
const seq = [...words, ...words];
---
<div class="marquee-big py-6 md:py-10" aria-hidden="true">
  <div class="track">
    {seq.map((w, i) => <span class:list={[i % 3 === 1 && 'fill', i % 3 === 2 && 'teal']}>{w}<span class="opacity-40">·</span></span>)}
  </div>
</div>
