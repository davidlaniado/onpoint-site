---
interface Props { title: string; icon?: 'shield' | 'chart' | 'check' | 'lock' | 'route' | 'eye' | 'card' | 'users' | 'bolt' }
const { title, icon = 'check' } = Astro.props;
const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  chart: '<path d="M4 19h16"/><path d="M7 15v-4M12 15V7M17 15v-6"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
  route: '<circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h5a4 4 0 004-4V8"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h4"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0112 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.5A5 5 0 0121 20"/>',
  bolt: '<path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z"/>',
};
---
<div class="card card-hover p-6 reveal">
  <span class="inline-flex w-10 h-10 rounded-xl bg-teal-soft text-teal-ink items-center justify-center">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
  </span>
  <h3 class="mt-4 text-lg font-bold">{title}</h3>
  <p class="mt-2 text-[15px] text-slate leading-relaxed"><slot /></p>
</div>
