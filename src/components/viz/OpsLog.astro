---
// OpsLog: a day at OnPoint as a live terminal. Lines append, oldest fade, day closes with a verdict line.
import VizFrame from './VizFrame.astro';
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const lines = [
  ['06:00', 'report', 'yesterday’s numbers in Slack'],
  ['08:30', 'creative', '22 new ads from the AI engine'],
  ['09:10', 'launch', '22 ads live across 3 accounts'],
  ['11:30', 'kill', '4 ads paused at the kill line'],
  ['13:00', 'partner', 'P-0331 onboarded, tracking test ✓'],
  ['14:00', 'scale', '3 winners doubled'],
  ['16:45', 'call', 'brand review, claim set updated'],
  ['18:00', 'numbers', 'cost per approved sale, logged'],
];
---
<VizFrame label="ops.log" right="one day" class={cls}>
  <div class:list={['ol', light && 'ol-light']} data-viz="ops-log" data-lines={JSON.stringify(lines)}>
    <ol class="ol-lines mono" aria-live="polite"></ol>
    <p class="mono ol-day" data-day>▍</p>
  </div>
</VizFrame>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  document.querySelectorAll<HTMLElement>('[data-viz="ops-log"]').forEach((root) => {
    const lines = JSON.parse(root.dataset.lines || '[]') as [string, string, string][];
    const list = root.querySelector<HTMLElement>('.ol-lines')!;
    const day = root.querySelector<HTMLElement>('[data-day]')!;
    const VERDICT = '✓ day: shipped · 24 launches · 4 kills · 3 scales';
    const make = ([t, tag, msg]: [string, string, string]) => {
      const li = document.createElement('li'); li.className = 'ol-line';
      li.innerHTML = `<span class="ol-t">${t}</span><span class="ol-tag">${tag}</span><span class="ol-arrow">→</span><span class="ol-msg">${msg}</span>`;
      return li;
    };
    if (reduce) { lines.forEach((l) => list.appendChild(make(l))); list.querySelectorAll('.ol-line').forEach((l) => l.classList.add('in')); day.textContent = VERDICT; day.classList.add('ok'); return; }
    const run = async () => {
      while (true) {
        list.querySelectorAll<HTMLElement>('.ol-line').forEach((l) => l.classList.add('out'));
        await wait(380); list.innerHTML = ''; day.textContent = '▍'; day.classList.remove('ok');
        for (const l of lines) {
          const li = make(l); list.appendChild(li); void li.offsetWidth; li.classList.add('in');
          const items = list.querySelectorAll<HTMLElement>('.ol-line');
          if (items.length > 8) { items[0].classList.add('out'); setTimeout(() => items[0].remove(), 400); }
          items.forEach((it, i) => it.classList.toggle('old', i < items.length - 3));
          await wait(950);
        }
        await wait(500); day.textContent = VERDICT; day.classList.add('ok');
        await wait(3200);
      }
    };
    run();
  });
</script>
