---
// Hero instrument: partner channels → OnPoint gate (5 checks) → brand offers. One path lit at a time; packets travel; footer log types.
import VizFrame from './VizFrame.astro';
import '../../styles/viz-flow.css';
const partners = [
  ['meta', 'P-0412'], ['search', 'P-0207'], ['email', 'P-0331'], ['sms', 'P-0118'], ['native', 'P-0290'], ['tiktok', 'P-0402'],
];
const checks = ['KYC', 'traffic source', 'claim set', 'placement', 'tracking test'];
const offers = [
  ['OFR-118', 'GLP-1 program', 'CPA'], ['OFR-121', 'TRT program', 'hybrid'], ['OFR-127', 'ED program', 'CPA'],
];
---
<VizFrame label="offer.flow" bare tone="none" class="offer-flow">
  <div class="of-wrap" id="offer-flow">
    <svg class="of-lines" aria-hidden="true"></svg>
    <div class="of-col of-left">
      <p class="of-colhead mono">partners · verified</p>
      {partners.map(([ch, id], i) => (
        <div class="of-chip node" data-partner={i}>
          <span class="mark ok" aria-hidden="true">✓</span>
          <span class="of-chan mono">{ch}</span>
          <span class="of-id mono">{id}</span>
        </div>
      ))}
    </div>
    <div class="of-col of-center">
      <div class="of-gate node" data-gate>
        <div class="of-gatehead">
          <span class="of-gatelogo" aria-hidden="true"></span>
          <span class="mono">onpoint · gate</span>
        </div>
        <ul class="of-checks">
          {checks.map((c, i) => (
            <li class="of-check" data-check={i}><span class="mark wait">·</span><span class="mono">{c}</span></li>
          ))}
        </ul>
        <div class="of-gatefoot"><span class="chip wait" data-gate-chip>verifying</span></div>
      </div>
    </div>
    <div class="of-col of-right">
      <p class="of-colhead mono">brands · offers</p>
      {offers.map(([id, name, struct], i) => (
        <div class="of-offer node" data-offer={i}>
          <div class="of-offerrow"><span class="of-id mono">{id}</span><span class="chip wait mono" data-offer-chip={i}>claim set ✓</span></div>
          <div class="of-offername">{name}</div>
          <div class="of-offerrow mono of-meta"><span>{struct}</span><span>channels · 4</span></div>
        </div>
      ))}
    </div>
  </div>
  <div class="viz-foot of-foot px-4 py-2.5 border-t border-line bg-paper font-mono text-[11px] text-slate">
    <span class="of-log truncate min-w-0 flex-1" data-log>click.received → P-0412 · verified</span>
    <span class="of-ms whitespace-nowrap text-teal-ink" data-ms></span>
  </div>
</VizFrame>

<script>
  const root = document.getElementById('offer-flow');
  if (root) {
    const svg = root.querySelector<SVGSVGElement>('.of-lines')!;
    const partners = [...root.querySelectorAll<HTMLElement>('[data-partner]')];
    const offers = [...root.querySelectorAll<HTMLElement>('[data-offer]')];
    const offerChips = [...root.querySelectorAll<HTMLElement>('[data-offer-chip]')];
    const gate = root.querySelector<HTMLElement>('[data-gate]')!;
    const checks = [...root.querySelectorAll<HTMLElement>('[data-check]')];
    const gateChip = root.querySelector<HTMLElement>('[data-gate-chip]')!;
    const log = root.parentElement!.querySelector<HTMLElement>('[data-log]')!;
    const ms = root.parentElement!.querySelector<HTMLElement>('[data-ms]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NS = 'http://www.w3.org/2000/svg';
    let leftPaths: SVGPathElement[] = [], rightPaths: SVGPathElement[] = [];
    let packetA: SVGCircleElement, packetB: SVGCircleElement;

    const rel = (el: HTMLElement) => { const r = el.getBoundingClientRect(), b = root.getBoundingClientRect(); return { x: r.left - b.left, y: r.top - b.top, w: r.width, h: r.height }; };
    const vertical = () => root.classList.contains('is-vertical');

    function draw() {
      const b = root.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${b.width} ${b.height}`);
      svg.setAttribute('width', String(b.width)); svg.setAttribute('height', String(b.height));
      svg.innerHTML = '';
      root.classList.toggle('is-vertical', b.width < 640);
      const g = rel(gate);
      leftPaths = []; rightPaths = [];
      const mk = (d: string, cls: string) => { const p = document.createElementNS(NS, 'path'); p.setAttribute('d', d); p.setAttribute('class', cls); svg.appendChild(p); return p; };
      partners.forEach((el) => {
        const r = rel(el);
        let d: string;
        if (vertical()) { const x1 = r.x + r.w / 2, y1 = r.y + r.h, x2 = g.x + g.w / 2, y2 = g.y, my = (y1 + y2) / 2; d = `M${x1},${y1} V${my} H${x2} V${y2}`; }
        else { const x1 = r.x + r.w, y1 = r.y + r.h / 2, x2 = g.x, y2 = g.y + g.h / 2, mx = x1 + (x2 - x1) * 0.55; d = `M${x1},${y1} H${mx} V${y2} H${x2}`; }
        leftPaths.push(mk(d, 'of-path'));
      });
      offers.forEach((el) => {
        const r = rel(el);
        let d: string;
        if (vertical()) { const x1 = g.x + g.w / 2, y1 = g.y + g.h, x2 = r.x + r.w / 2, y2 = r.y, my = (y1 + y2) / 2; d = `M${x1},${y1} V${my} H${x2} V${y2}`; }
        else { const x1 = g.x + g.w, y1 = g.y + g.h / 2, x2 = r.x, y2 = r.y + r.h / 2, mx = x1 + (x2 - x1) * 0.45; d = `M${x1},${y1} H${mx} V${y2} H${x2}`; }
        rightPaths.push(mk(d, 'of-path'));
      });
      packetA = document.createElementNS(NS, 'circle'); packetA.setAttribute('r', '4'); packetA.setAttribute('class', 'of-packet'); svg.appendChild(packetA);
      packetB = document.createElementNS(NS, 'circle'); packetB.setAttribute('r', '4'); packetB.setAttribute('class', 'of-packet of-packet-b'); svg.appendChild(packetB);
    }

    const sleep = (t: number) => new Promise((r) => setTimeout(r, t));
    function travel(packet: SVGCircleElement, path: SVGPathElement, dur: number, reverse = false) {
      return new Promise<void>((resolve) => {
        const L = path.getTotalLength(); const t0 = performance.now();
        packet.style.opacity = '1';
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur); const e = k < .5 ? 2 * k * k : -1 + (4 - 2 * k) * k;
          const p = path.getPointAtLength((reverse ? 1 - e : e) * L);
          packet.setAttribute('cx', String(p.x)); packet.setAttribute('cy', String(p.y));
          if (k < 1) requestAnimationFrame(step); else { packet.style.opacity = '0'; resolve(); }
        };
        requestAnimationFrame(step);
      });
    }
    function setLog(text: string, time?: string) {
      if (reduce) { log.textContent = text; ms.textContent = time || ''; return; }
      let k = 0; log.textContent = ''; ms.textContent = '';
      const iv = setInterval(() => { log.textContent = text.slice(0, ++k) + (k < text.length ? '▍' : ''); if (k >= text.length) { clearInterval(iv); ms.textContent = time || ''; } }, 18);
    }
    function resetGate() {
      checks.forEach((c) => { const m = c.querySelector('.mark')!; m.className = 'mark wait'; m.textContent = '·'; c.classList.remove('on'); });
      gateChip.className = 'chip wait'; gateChip.textContent = 'verifying';
    }
    function finished() {
      checks.forEach((c) => { const m = c.querySelector('.mark')!; m.className = 'mark ok'; m.textContent = '✓'; c.classList.add('on'); });
      gateChip.className = 'chip ok'; gateChip.textContent = 'cleared';
      leftPaths[0]?.classList.add('lit'); rightPaths[0]?.classList.add('lit');
      partners[0]?.classList.add('active'); offers[0]?.classList.add('active'); gate.classList.add('active');
      offerChips.forEach((c) => (c.className = 'chip ok mono'));
      setLog('postback.received → attributed → payout.cleared', '54ms');
    }
    async function loop() {
      let i = 0;
      while (true) {
        const pi = i % partners.length, oi = i % offers.length;
        const lp = leftPaths[pi], rp = rightPaths[oi];
        if (!lp || !rp) { await sleep(500); continue; }
        // 1. partner click → gate
        partners.forEach((p, k) => p.classList.toggle('active', k === pi));
        offers.forEach((o) => o.classList.remove('active')); gate.classList.remove('active');
        leftPaths.forEach((p) => p.classList.remove('lit')); rightPaths.forEach((p) => p.classList.remove('lit'));
        resetGate(); lp.classList.add('lit');
        setLog(`click.received → ${partners[pi].querySelector('.of-id')!.textContent} · ${partners[pi].querySelector('.of-chan')!.textContent}`);
        await travel(packetA, lp, 900);
        // 2. gate checks tick
        gate.classList.add('active');
        for (const c of checks) { const m = c.querySelector('.mark')!; m.className = 'mark ok'; m.textContent = '✓'; c.classList.add('on'); await sleep(260); }
        gateChip.className = 'chip ok'; gateChip.textContent = 'cleared';
        await sleep(300);
        // 3. gate → offer
        rp.classList.add('lit'); offers[oi].classList.add('active');
        setLog(`click.attributed → ${offers[oi].querySelector('.of-id')!.textContent} · landing → intake → charged`);
        await travel(packetA, rp, 900);
        offerChips[oi].className = 'chip ok mono';
        await sleep(500);
        // 4. postback back to partner
        setLog('postback.received → attributed → payout.cleared', '54ms');
        await travel(packetB, rp, 800, true);
        await travel(packetB, lp, 800, true);
        await sleep(1200);
        i++;
      }
    }
    draw();
    addEventListener('resize', () => { draw(); if (reduce) finished(); });
    if (reduce) finished(); else loop();
  }
</script>
