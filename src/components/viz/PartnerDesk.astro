---
// The partner's view: offers ledger, tracking link with click ID + sub IDs, today's funnel, payout status.
import VizFrame from './VizFrame.astro';
interface Props { compact?: boolean; class?: string }
const { compact = false, class: cls = '' } = Astro.props;
const rows = [
  { status: 'live', id: 'OFR-118', vertical: 'GLP-1', bar: 78 },
  { status: 'live', id: 'OFR-127', vertical: 'ED', bar: 54 },
  { status: 'verified', id: 'OFR-121', vertical: 'TRT', bar: 22 },
];
---
<VizFrame label="partner.desk" right="P-0412 · verified" class={cls} footer={compact ? undefined : 'one tracking link per offer · s2s postback on the charge · paid on approved performance'}>
  <div class:list={['pd', compact && 'pd-compact']} data-partner-desk>
    <table class="pd-table">
      <thead><tr><th>Status</th><th>Offer</th><th>Vertical</th><th class="pd-today">Today</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><span class:list={['chip', r.status === 'live' ? 'navy' : 'ok']}>{r.status}</span></td>
            <td class="mono">{r.id}</td>
            <td>{r.vertical}</td>
            <td class="pd-today"><span class="pd-bar"><span style={`width:${r.bar}%`}></span></span></td>
          </tr>
        ))}
        <tr class="pd-pending" data-pending>
          <td><span class="chip wait">pending</span></td>
          <td class="mono" data-pending-id>OFR-133</td>
          <td data-pending-vertical>Hair loss</td>
          <td class="pd-today"><span class="pd-bar pd-indeterminate"><span></span></span><span class="pd-note">checking placement…</span></td>
        </tr>
      </tbody>
    </table>
    <div class="pd-link mono"><span class="pd-link-k">link</span><span class="pd-link-v">trk.onpoint/o/118?clickid=<b>8f2a91c4</b>&amp;sub1=meta&amp;sub2=adset-14</span></div>
    <div class="pd-bottom">
      <div class="pd-funnel">
        <div class="pd-fcol"><span class="pd-fbar" style="height:100%"></span><span class="pd-flabel">intakes</span></div>
        <div class="pd-fcol"><span class="pd-fbar" style="height:58%"></span><span class="pd-flabel">checkouts</span></div>
        <div class="pd-fcol"><span class="pd-fbar pd-fbar-ok" style="height:34%"></span><span class="pd-flabel">approved</span></div>
      </div>
      <div class="pd-payout"><span class="mono-label">payout</span><span class="chip ok">approved performance → cleared</span></div>
    </div>
  </div>
</VizFrame>
<script>
  // the pending offer resolves to verified, then a new pending offer appears
  document.querySelectorAll<HTMLElement>('[data-partner-desk]').forEach((root) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const row = root.querySelector<HTMLElement>('[data-pending]'); if (!row) return;
    const chip = row.querySelector('.chip')!, bar = row.querySelector<HTMLElement>('.pd-bar')!, note = row.querySelector<HTMLElement>('.pd-note')!;
    const idEl = row.querySelector('[data-pending-id]')!, vEl = row.querySelector('[data-pending-vertical]')!;
    const queue = [['OFR-133', 'Hair loss'], ['OFR-140', 'Women’s HRT'], ['OFR-142', 'Diagnostics']];
    if (reduce) { chip.className = 'chip ok'; chip.textContent = 'verified'; bar.classList.remove('pd-indeterminate'); bar.innerHTML = '<span style="width:12%"></span>'; note.textContent = ''; return; }
    let i = 0;
    const resolve = () => {
      chip.className = 'chip ok'; chip.textContent = 'verified'; bar.classList.remove('pd-indeterminate'); bar.innerHTML = '<span style="width:12%"></span>'; note.textContent = 'placement approved';
      setTimeout(() => {
        i = (i + 1) % queue.length; row.classList.add('pd-swap');
        setTimeout(() => {
          idEl.textContent = queue[i][0]; vEl.textContent = queue[i][1];
          chip.className = 'chip wait'; chip.textContent = 'pending'; bar.classList.add('pd-indeterminate'); bar.innerHTML = '<span></span>'; note.textContent = 'checking placement…';
          row.classList.remove('pd-swap');
        }, 350);
      }, 2600);
    };
    setTimeout(resolve, 2200); setInterval(resolve, 6200);
  });
</script>
