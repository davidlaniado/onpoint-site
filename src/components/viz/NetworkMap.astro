---
import '../../styles/viz-covers.css';
// Dotted US map: HQ pin at Wyckoff NJ, partner/brand nodes light up one at a time with a line to the hub.
import VizFrame from './VizFrame.astro';
const HUB = { x: 868, y: 258 };
const nodes = [
  { x: 112, y: 378, id: 'P-0412', chip: 'meta' },
  { x: 128, y: 82, id: 'P-0207', chip: 'email' },
  { x: 218, y: 412, id: 'P-0331', chip: 'search' },
  { x: 252, y: 252, id: 'P-0161', chip: 'search' },
  { x: 332, y: 302, id: 'OFR-118', chip: 'brand' },
  { x: 432, y: 442, id: 'P-0519', chip: 'sms' },
  { x: 542, y: 152, id: 'P-0288', chip: 'tiktok' },
  { x: 622, y: 222, id: 'P-0102', chip: 'native' },
  { x: 642, y: 372, id: 'P-0377', chip: 'email' },
  { x: 702, y: 432, id: 'OFR-122', chip: 'brand' },
  { x: 736, y: 586, id: 'P-0450', chip: 'meta' },
  { x: 904, y: 206, id: 'OFR-131', chip: 'brand' },
];
const US = 'M110,60 L430,45 L560,80 L620,120 L700,70 L800,80 L880,100 L930,90 L915,150 L890,210 L868,250 L840,300 L805,395 L760,450 L730,520 L705,600 L690,560 L640,500 L560,540 L520,470 L440,505 L400,480 L300,480 L250,470 L200,430 L140,400 L95,300 L100,150 Z';
---
<VizFrame label="network.map" right="hq · wyckoff, nj" class="netmap">
  <div class="nm-wrap">
    <svg viewBox="0 0 1000 640" class="nm-svg" role="img" aria-label="Map of the United States with OnPoint headquarters in Wyckoff, New Jersey and partner and brand nodes across the country">
      <defs>
        <pattern id="nm-dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="8" cy="8" r="1.6" fill="#c9d2e3" /></pattern>
        <clipPath id="nm-clip"><path d={US} /></clipPath>
      </defs>
      <rect width="1000" height="640" fill="url(#nm-dots)" clip-path="url(#nm-clip)" />
      <path d={US} fill="none" stroke="#e4e8f0" stroke-width="1.5" />
      {nodes.map((n, i) => <line class="nm-line" data-i={i} x1={n.x} y1={n.y} x2={HUB.x} y2={HUB.y} />)}
      {nodes.map((n, i) => (
        <g class="nm-node" data-i={i}>
          <circle cx={n.x} cy={n.y} r="9" class="nm-halo" />
          <circle cx={n.x} cy={n.y} r="4" class="nm-pt" />
        </g>
      ))}
      <g class="nm-hub">
        <circle cx={HUB.x} cy={HUB.y} r="16" class="nm-hub-halo" />
        <circle cx={HUB.x} cy={HUB.y} r="6" class="nm-hub-pt" />
      </g>
    </svg>
    {nodes.map((n, i) => (
      <div class="nm-label" data-i={i} style={`left:${n.x / 10}%;top:${n.y / 6.4}%`}><span class="mono">{n.id}</span><span class="chip">{n.chip}</span></div>
    ))}
    <div class="nm-label nm-hq" style={`left:${HUB.x / 10}%;top:${HUB.y / 6.4}%`}><span class="mono">OnPoint · HQ</span></div>
  </div>
</VizFrame>
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.netmap').forEach((map) => {
    const lines = map.querySelectorAll<SVGLineElement>('.nm-line');
    const nodes = map.querySelectorAll<SVGGElement>('.nm-node');
    const labels = map.querySelectorAll<HTMLElement>('.nm-label:not(.nm-hq)');
    const n = lines.length; let i = 0;
    const set = (k: number) => { lines.forEach((l, j) => l.classList.toggle('on', j === k)); nodes.forEach((g, j) => g.classList.toggle('on', j === k)); labels.forEach((l, j) => l.classList.toggle('on', j === k)); };
    if (reduce) { lines.forEach((l) => l.classList.add('on')); nodes.forEach((g) => g.classList.add('on')); labels.forEach((l) => l.classList.add('on')); return; }
    set(0); setInterval(() => { i = (i + 1) % n; set(i); }, 1500);
  });
</script>
