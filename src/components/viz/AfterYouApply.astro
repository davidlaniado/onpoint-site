---
import '../../styles/viz-covers.css';
// What happens after you apply: three numbered cards, each with a mini instrument (Cal.com / Attio pattern).
interface Props { audience?: 'brands' | 'partners' | 'both' }
const { audience = 'both' } = Astro.props;
const checks = audience === 'brands'
  ? ['business verified', 'compliance review', 'funnel review']
  : audience === 'partners'
  ? ['identity verified', 'KYC cleared', 'traffic source disclosed']
  : ['identity · business', 'KYC · compliance', 'traffic source disclosed'];
---
<div class="aya grid md:grid-cols-3 gap-4">
  <div class="card aya-card reveal">
    <div class="aya-head"><span class="chip">01</span><p class="aya-t">Verification</p></div>
    <p class="aya-s">Both sides are checked before anything is shown or sent.</p>
    <div class="aya-inst">
      {checks.map((c, i) => <div class="cv-row" style={`--d:${i * 260}ms`}><span class="mark ok">✓</span><span>{c}</span></div>)}
      <div class="aya-foot mono"><span class="aya-spin"></span>running checks — entity, domain, traffic source</div>
    </div>
  </div>
  <div class="card aya-card reveal">
    <div class="aya-head"><span class="chip">02</span><p class="aya-t">Offer and terms</p></div>
    <p class="aya-s">Everything is agreed in writing before launch.</p>
    <div class="aya-inst aya-chips">
      {['claim set · approved', 'channels · meta, search', 'cap · set', 'structure · CPA / revshare / hybrid', 'tracking test · passed'].map((c, i) => <span class="chip ok" style={`--d:${i * 180}ms`}>{c}</span>)}
    </div>
  </div>
  <div class="card aya-card reveal">
    <div class="aya-head"><span class="chip">03</span><p class="aya-t">Live with partners</p></div>
    <p class="aya-s">Verified partners on approved channels. Same numbers on both sides.</p>
    <div class="aya-inst">
      <div class="aya-ledger">
        <div class="aya-lrow"><span class="chip ok">live</span><span class="mono">OFR-118</span><span class="aya-bar"><span style="--w:.82"></span></span></div>
        <div class="aya-lrow"><span class="chip ok">live</span><span class="mono">P-0412</span><span class="aya-bar"><span style="--w:.64"></span></span></div>
        <div class="aya-lrow"><span class="chip wait">pending</span><span class="mono">P-0519</span><span class="aya-bar aya-ind"><span></span></span></div>
      </div>
      <div class="aya-foot mono">✓ action: clear · 54ms</div>
    </div>
  </div>
</div>
