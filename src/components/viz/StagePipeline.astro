---
// APPLY → VERIFY → LIVE → CLEARED with a Brands / Partners toggle. Middesk-style stage tiles.
import VizFrame from './VizFrame.astro';
interface Props { class?: string; side?: 'brands' | 'partners' }
const { class: cls = '', side = 'brands' } = Astro.props;
const stages = ['apply', 'verify', 'live', 'cleared'];
const copy = {
  brands: ['business + compliance review', 'claim set + terms locked', 'verified partners only', 'reconciled, auditable'],
  partners: ['identity + KYC', 'channel + placement approved', 'tracking links + test conversion', 'paid on approved performance'],
};
const icons = [
  '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 10h8M8 14h5"/>',
  '<path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>',
  '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h4"/>',
];
---
<VizFrame label="stage.pipeline" right="apply → cleared" class={cls}>
  <div class="sp" data-stage-pipeline data-side={side}>
    <div class="sp-toggle" role="tablist" aria-label="Show steps for">
      <button type="button" role="tab" class:list={['sp-tab', side === 'brands' && 'active']} data-side-btn="brands" aria-selected={side === 'brands'}>Brands</button>
      <button type="button" role="tab" class:list={['sp-tab', side === 'partners' && 'active']} data-side-btn="partners" aria-selected={side === 'partners'}>Partners</button>
    </div>
    <ol class="sp-stages">
      {stages.map((s, i) => (
        <li class:list={['sp-stage', i === 2 && 'active']} data-stage={i}>
          <span class="sp-chip mono">{s}</span>
          <span class="sp-tile" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></span>
          <span class="sp-copy" data-brands={copy.brands[i]} data-partners={copy.partners[i]}>{copy[side][i]}</span>
        </li>
      ))}
    </ol>
  </div>
</VizFrame>
<script>
  document.querySelectorAll<HTMLElement>('[data-stage-pipeline]').forEach((root) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stages = [...root.querySelectorAll<HTMLElement>('.sp-stage')];
    const copies = [...root.querySelectorAll<HTMLElement>('.sp-copy')];
    const setSide = (side: string) => {
      root.dataset.side = side;
      root.querySelectorAll<HTMLElement>('[data-side-btn]').forEach((b) => { const on = b.dataset.sideBtn === side; b.classList.toggle('active', on); b.setAttribute('aria-selected', String(on)); });
      copies.forEach((c) => { c.classList.add('sp-fade'); setTimeout(() => { c.textContent = c.dataset[side] || ''; c.classList.remove('sp-fade'); }, 180); });
    };
    root.querySelectorAll<HTMLElement>('[data-side-btn]').forEach((b) => b.addEventListener('click', () => setSide(b.dataset.sideBtn!)));
    if (reduce) return;
    let i = 2;
    setInterval(() => { i = (i + 1) % stages.length; stages.forEach((s, k) => { s.classList.toggle('active', k === i); s.classList.toggle('done', k < i); }); }, 1500);
  });
</script>
