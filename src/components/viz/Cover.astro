---
import '../../styles/viz-covers.css';
// Linear "FIG 0.N" style line-drawing covers for blog posts and program pages. Pure HTML/CSS/SVG.
import VizFrame from './VizFrame.astro';
type Kind = 'payouts' | 'compliant' | 'vet' | 'postback' | 'claims' | 'funnel' | 'offer-sheet' | 'channel-rules' | 'offer-controls';
interface Props { kind: Kind; title?: string; ratio?: '16/9' | '4/3'; eager?: boolean; static?: boolean; subject?: string; class?: string }
const { kind, title, ratio = '16/9', eager = false, static: isStatic = false, subject, class: cls = '' } = Astro.props;
const meta: Record<Kind, { n: string; name: string; foot: string }> = {
  payouts: { n: '01', name: 'payouts', foot: 'cpa → first order · revenue share → renewals · hybrid → both' },
  compliant: { n: '02', name: 'traffic gate', foot: 'source · claims · funnel · tracking → all four or nothing' },
  vet: { n: '03', name: 'scorecard', foot: '9 checks before you send a click' },
  postback: { n: '04', name: 's2s postback', foot: 'click id → charged → postback → everflow → attributed' },
  claims: { n: '05', name: 'claim set', foot: 'brand approves · partners build inside it · network enforces' },
  funnel: { n: '06', name: 'funnel', foot: 'five numbers, top to bottom, every morning' },
  'offer-sheet': { n: '07', name: 'offer sheet', foot: 'pays on charged first order · approved channels only' },
  'channel-rules': { n: '08', name: 'channel rules', foot: 'allowed · required · off limits · tracking' },
  'offer-controls': { n: '09', name: 'offer controls', foot: 'the brand owns every switch' },
};
const m = meta[kind];
const label = title ?? `fig. ${m.n} — ${m.name}`;
const vertical = subject ?? 'GLP-1 program';
const channel = subject ?? 'Meta';
---
<VizFrame label={label} live={false} right={`OFR-118`} footer={m.foot} class={`cover cover-${kind} ${cls}`}>
  <div class:list={['cover-body', ratio === '4/3' ? 'aspect-[4/3]' : 'aspect-[16/9]', (isStatic || eager) && 'in']} data-cover={isStatic ? 'static' : ''}>
    {kind === 'payouts' && (
      <div class="cv-payouts">
        {[['CPA', 'first order', [1]], ['revenue share', 'renewals', [0.35, 0.5, 0.62, 0.78, 0.9]], ['hybrid', 'both', [0.55, 0.3, 0.38, 0.45]]].map(([t, s, bars]) => (
          <div class="cv-card">
            <p class="cv-t">{t}</p>
            <div class="cv-bars">{(bars as number[]).map((h, i) => <span class="cv-bar" style={`--h:${h};--d:${i * 120}ms`}></span>)}</div>
            <p class="cv-s">{s}</p>
          </div>
        ))}
      </div>
    )}
    {kind === 'compliant' && (
      <div class="cv-gate">
        <span class="chip">traffic · P-0412</span>
        <span class="cv-line"></span>
        <div class="cv-gatebox">
          {['source disclosed', 'claims approved', 'brand funnel', 'tracking auditable'].map((t, i) => <div class="cv-row" style={`--d:${i * 260}ms`}><span class="mark ok">✓</span><span>{t}</span></div>)}
        </div>
        <span class="cv-line"></span>
        <span class="chip ok" style="--d:1200ms">attributed</span>
      </div>
    )}
    {kind === 'vet' && (
      <div class="cv-score">
        {['legal entity', 'how you were approved', 'named advertiser', 'terms in writing', 'test conversion', 'reversal rules', 'payment timing', 'claim rules', 'who answers'].map((t, i) => (
          <div class="cv-tile" style={`--d:${i * 110}ms`}><span class="cv-n">{String(i + 1).padStart(2, '0')}</span><span class="cv-tt">{t}</span><span class="mark ok">✓</span></div>
        ))}
      </div>
    )}
    {kind === 'postback' && (
      <div class="cv-trace">
        {[['click', '8f2a…'], ['charged', '14:02:11'], ['s2s postback', 'received'], ['everflow', 'matched'], ['attributed', 'P-0412']].map(([t, s], i) => (
          <div class="cv-step" style={`--d:${i * 320}ms`}><span class="cv-dot"></span><span class="cv-st">{t}</span><span class="cv-ss">{s}</span></div>
        ))}
        <span class="cv-rail"></span><span class="packet cv-packet"></span>
      </div>
    )}
    {kind === 'claims' && (
      <div class="cv-doc">
        <div class="cv-dochead"><span class="mono">claim set · OFR-118</span><span class="chip ok">approved by brand</span></div>
        {['provider-reviewed program', 'licensed U.S. pharmacy', 'monthly price shown up front'].map((t, i) => <div class="cv-row" style={`--d:${i * 240}ms`}><span class="mark ok">✓</span><span>{t}</span></div>)}
        <div class="cv-row cv-strike" style="--d:900ms"><span class="mark bad">✕</span><span class="cv-s-text">lose 20 lbs in 30 days</span><span class="chip bad">off limits</span></div>
      </div>
    )}
    {kind === 'funnel' && (
      <div class="cv-funnel">
        {[['quiz start', 1], ['cost per quiz start', 0.78], ['checkout', 0.52], ['cost per approved sale', 0.36], ['checkout → sale', 0.24]].map(([t, w], i) => (
          <div class="cv-frow" style={`--w:${w};--d:${i * 150}ms`}><span class="cv-fl">{t}</span><span class="cv-fbar"><span></span></span></div>
        ))}
      </div>
    )}
    {kind === 'offer-sheet' && (
      <div class="cv-doc">
        <div class="cv-dochead"><span class="mono">offer sheet · OFR-118</span><span class="chip">{vertical}</span></div>
        <div class="cv-kv" style="--d:150ms"><span class="cv-k">pays on</span><span class="cv-v">charged first order</span></div>
        <div class="cv-kv" style="--d:300ms"><span class="cv-k">channels</span><span class="cv-v cv-chips"><span class="chip ok">meta</span><span class="chip ok">search</span><span class="chip ok">email</span></span></div>
        <div class="cv-kv" style="--d:450ms"><span class="cv-k">approved</span><span class="cv-v"><span class="mark ok">✓</span> provider-reviewed program</span></div>
        <div class="cv-kv" style="--d:600ms"><span class="cv-k">off limits</span><span class="cv-v"><span class="mark bad">✕</span> guaranteed results</span></div>
      </div>
    )}
    {kind === 'channel-rules' && (
      <div class="cv-doc">
        <div class="cv-dochead"><span class="mono">channel rules · {channel}</span><span class="chip ok">verified P-0412</span></div>
        <div class="cv-kv" style="--d:150ms"><span class="cv-k">allowed</span><span class="cv-v cv-chips"><span class="chip ok">approved pages</span><span class="chip ok">claim set</span></span></div>
        <div class="cv-kv" style="--d:300ms"><span class="cv-k">required</span><span class="cv-v cv-chips"><span class="chip">own accounts</span><span class="chip">disclosed source</span></span></div>
        <div class="cv-kv" style="--d:450ms"><span class="cv-k">off limits</span><span class="cv-v cv-chips"><span class="chip bad">borrowed accounts</span><span class="chip bad">unapproved claims</span></span></div>
        <div class="cv-kv" style="--d:600ms"><span class="cv-k">tracking</span><span class="cv-v cv-chips"><span class="chip">click id</span><span class="chip">s2s postback</span></span></div>
      </div>
    )}
    {kind === 'offer-controls' && (
      <div class="cv-toggles">
        {[['claim set', 'approved (12)'], ['channels', 'meta · search'], ['cap', 'set'], ['creative approval', 'required']].map(([t, s], i) => (
          <div class="cv-trow" style={`--d:${i * 200}ms`}><span class="cv-toggle"><span></span></span><span class="cv-tl">{t}</span><span class="chip ok">{s}</span></div>
        ))}
      </div>
    )}
  </div>
</VizFrame>
<script>
  // one-time scroll-in: adds .in so CSS keyed animations run once; static covers and reduced motion show the finished state
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('.cover-body');
  els.forEach((el) => {
    if (reduce || el.dataset.cover === 'static') { el.classList.add('in', 'now'); return; }
  });
  if (!reduce) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -10% 0px' });
    els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
  }
</script>
