---
import { href } from '../lib/site';
interface Props { kicker: string; title: string; lead?: string; primary?: [string, string]; secondary?: [string, string]; pills?: string[]; narrow?: boolean }
const { kicker, title, lead, primary, secondary, pills = [], narrow = false } = Astro.props;
---
<section class="hero-light">
  <div class:list={['container-x py-14 md:py-20', narrow && 'max-w-3xl']}>
    <p class="text-teal-ink font-semibold text-sm md:text-[15px]" data-hero style="opacity:0;transform:translateY(16px)">{kicker}</p>
    <h1 class="mt-4 text-navy text-[38px] leading-[1.05] sm:text-[48px] lg:text-[56px] font-extrabold tracking-[-0.02em] max-w-4xl" data-hero style="opacity:0;transform:translateY(16px)" set:html={title} />
    {lead && <p class="mt-6 text-lg md:text-xl text-slate max-w-2xl leading-relaxed" data-hero style="opacity:0;transform:translateY(16px)">{lead}</p>}
    {(primary || secondary) && <div class="mt-8 flex flex-col sm:flex-row gap-3" data-hero style="opacity:0;transform:translateY(16px)">
      {primary && <a href={primary[1].startsWith('#') ? primary[1] : href(primary[1])} class="btn btn-primary">{primary[0]}</a>}
      {secondary && <a href={secondary[1].startsWith('#') ? secondary[1] : href(secondary[1])} class="btn btn-ghost">{secondary[0]}</a>}
    </div>}
    {pills.length > 0 && <ul class="mt-7 flex flex-wrap gap-2" data-hero style="opacity:0;transform:translateY(16px)">{pills.map((t) => <li class="pill-outline">{t}</li>)}</ul>}
  </div>
</section>
