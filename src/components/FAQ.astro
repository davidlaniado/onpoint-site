---
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line" data-faq>
  {items.map((f) => (
    <details class="faq-item group py-4">
      <summary class="flex items-start justify-between gap-6 cursor-pointer list-none font-display font-bold text-navy text-[17px] md:text-lg leading-snug">
        <span>{f.q}</span>
        <span class="faq-icon mt-1 shrink-0 w-6 h-6 rounded-full border border-line flex items-center justify-center text-mist" aria-hidden="true"></span>
      </summary>
      <div class="faq-body"><div><p class="mt-3 text-slate leading-relaxed max-w-3xl">{f.a}</p></div></div>
    </details>
  ))}
</div>
<script>
  // Animated close: <details> removes content instantly on close, so delay the [open] removal until the grid collapse finishes.
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((d) => {
    const summary = d.querySelector('summary')!;
    summary.addEventListener('click', (e) => {
      if (!d.open || d.classList.contains('closing')) return;
      e.preventDefault();
      d.classList.add('closing');
      const body = d.querySelector('.faq-body') as HTMLElement;
      const done = () => { d.open = false; d.classList.remove('closing'); };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return done();
      let fired = false;
      body.addEventListener('transitionend', (ev) => { if (ev.propertyName === 'grid-template-rows' && !fired) { fired = true; done(); } }, { once: true });
      setTimeout(() => { if (!fired) { fired = true; done(); } }, 600);
    });
  });
</script>
