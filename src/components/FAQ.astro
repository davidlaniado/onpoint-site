---
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((f) => (
    <details class="group py-4">
      <summary class="flex items-start justify-between gap-6 cursor-pointer list-none font-display font-bold text-navy text-[17px] md:text-lg leading-snug">
        <span>{f.q}</span>
        <span class="mt-1 shrink-0 w-6 h-6 rounded-full border border-line flex items-center justify-center text-mist group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-slate leading-relaxed max-w-3xl">{f.a}</p>
    </details>
  ))}
</div>
