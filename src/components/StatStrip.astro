---
const stats = [
  { n: '$1B+', count: 1, prefix: '$', suffix: 'B+', l: 'in revenue driven for brands our founders have scaled' },
  { n: '7', count: 7, l: 'offices built at our founders’ last performance company' },
  { n: '5', count: 5, l: 'health categories supported' },
  { n: 'ATA', l: 'founders are American Telemedicine Association members' },
] as { n: string; count?: number; prefix?: string; suffix?: string; l: string }[];
---
<section class="container-x">
  <div class="grid grid-cols-2 lg:grid-cols-4 border-y border-line divide-x divide-line" data-stats>
    {stats.map((s) => (
      <div class="stat-cell py-6 md:py-8 px-4 md:px-6 first:pl-0">
        <p class="stat-num font-display text-3xl md:text-4xl font-extrabold text-navy tracking-tight" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.n}</p>
        <p class="mt-1 font-mono text-[11px] leading-snug text-mist uppercase tracking-wider">{s.l}</p>
      </div>
    ))}
  </div>
</section>
<script>
  // Accent line draws + number pops when the strip enters view. The count itself is driven by motion.ts (data-count).
  const strip = document.querySelector('[data-stats]');
  if (strip) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      strip.querySelectorAll('.stat-cell').forEach((c) => c.classList.add('is-in'));
      io.disconnect();
    }, { rootMargin: '0px 0px -10% 0px' });
    io.observe(strip);
  }
</script>
