---
import { SITE } from '../lib/site';
// Static-site form: FormSubmit relays to SITE.email. First submission triggers a one-time
// activation email to that inbox. Swap the action for any other form endpoint later.
const action = `https://formsubmit.co/ajax/${SITE.email}`;
---
<form id="contact-form" action={action} method="POST" class="card p-6 md:p-8 grid gap-4" novalidate>
  <input type="hidden" name="_subject" value="New inquiry from onpointhealthmedia.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
  <div class="grid sm:grid-cols-2 gap-4">
    <label class="grid gap-1.5 text-sm font-medium text-navy">First name
      <input required name="first_name" autocomplete="given-name" class="h-11 rounded-lg border border-line px-3 text-base text-ink focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30" />
    </label>
    <label class="grid gap-1.5 text-sm font-medium text-navy">Last name
      <input required name="last_name" autocomplete="family-name" class="h-11 rounded-lg border border-line px-3 text-base text-ink focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30" />
    </label>
  </div>
  <label class="grid gap-1.5 text-sm font-medium text-navy">Work email
    <input required type="email" name="email" autocomplete="email" class="h-11 rounded-lg border border-line px-3 text-base text-ink focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30" />
  </label>
  <div class="grid sm:grid-cols-2 gap-4">
    <label class="grid gap-1.5 text-sm font-medium text-navy">I am a
      <select name="i_am" id="i-am" class="h-11 rounded-lg border border-line px-3 text-base text-ink bg-white focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30">
        <option value="Brand / advertiser">Brand / advertiser</option>
        <option value="Media partner / affiliate">Media partner / affiliate</option>
        <option value="Candidate">Candidate</option>
        <option value="Other">Other</option>
      </select>
    </label>
    <label class="grid gap-1.5 text-sm font-medium text-navy">Company or website
      <input name="company" class="h-11 rounded-lg border border-line px-3 text-base text-ink focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30" />
    </label>
  </div>
  <label class="grid gap-1.5 text-sm font-medium text-navy">What are you trying to grow?
    <textarea required name="message" rows="5" class="rounded-lg border border-line px-3 py-2.5 text-base text-ink focus:outline-none focus:border-teal focus:ring-2 focus:ring-teal/30"></textarea>
  </label>
  <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">Send message</button>
  <p id="form-status" class="text-sm text-slate" aria-live="polite"></p>
  <p class="text-xs text-mist">No spam, no lists. Prefer email? <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
</form>
<script>
  const f = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const sel = document.getElementById('i-am') as HTMLSelectElement | null;
  const as = new URLSearchParams(location.search).get('as');
  if (sel && as === 'partner') sel.value = 'Media partner / affiliate';
  if (sel && as === 'candidate') sel.value = 'Candidate';
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!f.checkValidity()) { f.reportValidity(); return; }
    const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; if (status) status.textContent = 'Sending…';
    try {
      const r = await fetch(f.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(f) });
      if (!r.ok) throw new Error(String(r.status));
      f.reset(); if (status) status.textContent = 'Thanks. A real person will get back to you within one to two business days.';
    } catch {
      if (status) status.textContent = 'Something went wrong. Email us directly at david@onpointhealthmedia.com.';
    } finally { btn.disabled = false; }
  });
</script>
