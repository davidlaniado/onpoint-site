---
import { NAV, href } from '../lib/site';
const current = Astro.url.pathname;
const isActive = (p: string) => current.startsWith(href(p).replace(/\/$/, ''));
---
<header data-nav class="sticky top-0 z-50 backdrop-blur border-b">
  <div class="container-x flex items-center justify-between h-16 md:h-[68px]">
    <a href={href('/')} class="flex items-center" aria-label="OnPoint home">
      <img src={href('/img/logo.png')} srcset={`${href('/img/logo-2x.png')} 2x`} alt="OnPoint Health Media & Tech" class="nav-logo-dark h-8 md:h-9 w-auto" width="720" height="195" />
      <img src={href('/img/logo.png')} srcset={`${href('/img/logo-2x.png')} 2x`} alt="" aria-hidden="true" class="nav-logo-light h-8 md:h-9 w-auto brightness-0 invert" width="720" height="195" />
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[15px] font-medium text-navy" aria-label="Main">
      {NAV.map((n) => (
        <a href={href(n.path)} class="nav-link">{n.label}</a>
      ))}
      <a href={href('/contact/')} class="btn btn-teal !py-2.5 !px-5 text-sm">Book a call</a>
    </nav>
    <button id="nav-toggle" class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg border text-navy" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="nav-open" d="M3 5h14M3 10h14M3 15h14"/><path class="nav-close hidden" d="M5 5l10 10M15 5L5 15"/></svg>
    </button>
  </div>
  <div id="nav-mobile" class="md:hidden border-t" aria-hidden="true">
    <nav class="container-x flex flex-col" aria-label="Mobile">
      <div class="py-3 flex flex-col">
        {NAV.map((n) => (
          <a href={href(n.path)} class="py-3 text-[17px] font-medium text-navy border-b last:border-0">{n.label}</a>
        ))}
        <a href={href('/contact/')} class="btn btn-teal mt-3">Book a call</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const t = document.getElementById('nav-toggle');
  const m = document.getElementById('nav-mobile');
  const setOpen = (open: boolean) => {
    if (!t || !m) return;
    m.classList.toggle('open', open);
    m.setAttribute('aria-hidden', String(!open));
    t.setAttribute('aria-expanded', String(open));
    t.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    t.querySelector('.nav-open')?.classList.toggle('hidden', open);
    t.querySelector('.nav-close')?.classList.toggle('hidden', !open);
  };
  t?.addEventListener('click', () => setOpen(!m?.classList.contains('open')));
  m?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
