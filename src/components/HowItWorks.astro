---
// Pinned scroll scene: left rail sticks while each step activates as it crosses the middle of the screen.
const steps = [
  { t: 'Verify', b: 'Business, credential, and compliance review.', p: 'Identity, KYC, and traffic source verification.' },
  { t: 'Agree terms', b: 'Offer intake, claims review, and CPA, revenue share, or hybrid terms locked in writing.', p: 'Channel and placement approval, offer rules, and defined payout terms.' },
  { t: 'Review', b: 'Funnel, creative, and conversion flow checked against advertising standards.', p: 'Access to approved creative structures and the claim set for each offer.' },
  { t: 'Wire tracking', b: 'Click ID through the funnel, server-to-server postback on the charge, reversal events on refunds.', p: 'Tracking links, sub IDs, and a test conversion confirmed before spend.' },
  { t: 'Launch', b: 'Verified partners on approved channels only.', p: 'Launch support and optimization guidance from people who buy media themselves.' },
  { t: 'Report and pay', b: 'Partner-level attribution, funnel events, and reconciliation you can audit.', p: 'Transparent reporting and payouts on approved performance.' },
];
---
<section class="container-x py-12 md:py-16" data-steps>
  <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
    <div class="lg:sticky lg:top-28">
      <p class="eyebrow">How OnPoint operates</p>
      <h2 class="mt-4 text-[30px] md:text-[40px] leading-[1.12] font-extrabold" data-split>Verify, launch, track, pay. In that order.</h2>
      <p class="mt-4 text-lg text-slate leading-relaxed">Six steps. Both sides go through them. Nothing runs before step five.</p>
      <div class="mt-8 hidden lg:flex items-end gap-6">
        <p class="font-display font-extrabold leading-none text-[96px] text-white/90 tabular-nums" data-step-num>01</p>
        <div class="pb-3">
          <p class="mono-label">step</p>
          <p class="font-display font-bold text-2xl text-white" data-step-title>{steps[0].t}</p>
        </div>
        <div class="ml-auto w-1 h-28 rounded-full bg-white/10 overflow-hidden"><div class="w-full h-full bg-teal origin-top" data-step-fill style="transform:scaleY(0.166)"></div></div>
      </div>
    </div>
    <ol class="space-y-4">
      {steps.map((s, i) => (
        <li class="hiw-step card p-6 md:p-7 border" data-step={s.t}>
          <div class="flex items-center gap-3">
            <span class="step-index w-9 h-9 rounded-full bg-white/10 text-white font-mono text-xs flex items-center justify-center">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-xl font-bold text-white">{s.t}</h3>
          </div>
          <div class="mt-4 grid sm:grid-cols-2 gap-4">
            <div><p class="mono-label mb-1">Brands</p><p class="text-[15px] text-slate leading-relaxed">{s.b}</p></div>
            <div><p class="mono-label mb-1">Partners</p><p class="text-[15px] text-slate leading-relaxed">{s.p}</p></div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
