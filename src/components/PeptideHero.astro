---
// Futuristic peptide object: frosted glass vial, glowing teal peptide helix inside, floating particles. Pure three.js.
---
<div class="pep-wrap" data-hero style="opacity:0;transform:translateY(16px)">
  <div class="pep-glow" aria-hidden="true"></div>
  <canvas id="pep-canvas" class="pep-canvas" aria-label="3D peptide vial"></canvas>
  </div>
<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const canvas = document.getElementById('pep-canvas') as HTMLCanvasElement | null;
  const wrap = canvas?.parentElement as HTMLElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;

  function start() {
    if (!canvas || !wrap) return;
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, fine ? 2 : 1.5));
    renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.0;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100); camera.position.set(0, 0.05, 6.4);
    scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;

    const group = new THREE.Group(); scene.add(group);

    // one slim capsule, horizontal-ish: left half matte white, right half clear glass with the peptide chain inside
    const L = 3.4, R = 0.62;
    const white = new THREE.Mesh(new THREE.CapsuleGeometry(R, L / 2, 24, 48), new THREE.MeshPhysicalMaterial({ color: 0xf4f7fb, roughness: 0.3, metalness: 0, clearcoat: 0.7, clearcoatRoughness: 0.2 }));
    white.rotation.z = Math.PI / 2;
    // clip the white half so it ends flat at the seam
    const seamPlane = new THREE.Plane(new THREE.Vector3(-1, 0, 0), 0); // keep x < 0
    (white.material as THREE.Material).clippingPlanes = [seamPlane]; (white.material as THREE.Material).clipShadows = true;
    group.add(white);
    const glass = new THREE.Mesh(new THREE.CapsuleGeometry(R, L / 2, 24, 48), new THREE.MeshPhysicalMaterial({ color: 0xcfeeea, transmission: 0.92, roughness: 0.06, thickness: 1.0, ior: 1.45, clearcoat: 1, clearcoatRoughness: 0.04, transparent: true, opacity: 0.85 }));
    glass.rotation.z = Math.PI / 2;
    (glass.material as THREE.Material).clippingPlanes = [new THREE.Plane(new THREE.Vector3(1, 0, 0), 0)]; // keep x > 0
    group.add(glass);
    renderer.localClippingEnabled = true;
    // seam ring
    const seam = new THREE.Mesh(new THREE.TorusGeometry(R - 0.015, 0.022, 16, 96), new THREE.MeshStandardMaterial({ color: 0x60d8c8, metalness: 0.8, roughness: 0.2, emissive: 0x14867a, emissiveIntensity: 0.4 }));
    seam.rotation.y = Math.PI / 2; group.add(seam);

    // peptide chain inside the glass half: a single helix of small glowing beads
    const helix = new THREE.Group(); group.add(helix);
    const beadGeo = new THREE.SphereGeometry(0.075, 20, 20);
    const beadMat = new THREE.MeshStandardMaterial({ color: 0x14867a, emissive: 0x14867a, emissiveIntensity: 0.9, roughness: 0.35, metalness: 0.2 });
    const linkMat = new THREE.MeshStandardMaterial({ color: 0x3890b0, emissive: 0x3890b0, emissiveIntensity: 0.4, transparent: true, opacity: 0.9 });
    const N = 16, hr = 0.3, span = L / 4 + 0.2;
    let prev: THREE.Vector3 | null = null; const beads: THREE.Mesh[] = []; const links: THREE.Mesh[] = [];
    for (let i = 0; i < N; i++) {
      const t = i / (N - 1), x = 0.15 + t * span, a = t * Math.PI * 3;
      const pt = new THREE.Vector3(x, Math.cos(a) * hr, Math.sin(a) * hr);
      const b = new THREE.Mesh(beadGeo, beadMat); b.position.copy(pt); helix.add(b);
      const dir = new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize().multiplyScalar(1.6 + Math.random() * 1.6);
      (b as any).userData = { rest: pt.clone(), burst: dir, spin: new THREE.Vector3(Math.random(), Math.random(), Math.random()) };
      beads.push(b);
      if (prev) { const d = pt.clone().sub(prev); const link = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, d.length(), 8), linkMat); link.position.copy(prev).add(d.clone().multiplyScalar(0.5)); link.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), d.clone().normalize()); helix.add(link); links.push(link); }
      prev = pt;
    }
    const particles = new THREE.Group(); const ring1 = new THREE.Group(); const ring2 = new THREE.Group(); const beadA = beadMat;
    group.rotation.set(0.22, -0.3, -0.55); group.scale.setScalar(1.15);

    // burst cloud: fine particles that fly outward from the seam as you scroll
    const BC = 420, bpos = new Float32Array(BC * 3), bdir: THREE.Vector3[] = [];
    for (let i = 0; i < BC; i++) { const v = new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize().multiplyScalar(1.2 + Math.random() * 3); bdir.push(v); bpos[i * 3] = 0; bpos[i * 3 + 1] = 0; bpos[i * 3 + 2] = 0; }
    const burstGeo = new THREE.BufferGeometry().setAttribute('position', new THREE.BufferAttribute(bpos, 3));
    const burstMat = new THREE.PointsMaterial({ color: 0x14867a, size: 0.045, transparent: true, opacity: 0, sizeAttenuation: true, depthWrite: false });
    const burst = new THREE.Points(burstGeo, burstMat); group.add(burst);
    const seamMat = seam.material as THREE.MeshStandardMaterial; seamMat.transparent = true;
    const glassMat = glass.material as THREE.MeshPhysicalMaterial; const whiteMat = white.material as THREE.MeshPhysicalMaterial; whiteMat.transparent = true;
    const ease = (x: number) => x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
    scene.add(new THREE.HemisphereLight(0xffffff, 0x9fb3d9, 0.7));
    const key = new THREE.DirectionalLight(0xffffff, 2.4); key.position.set(-3, 5, 4); scene.add(key);
    const fill = new THREE.DirectionalLight(0xbfe8ff, 0.8); fill.position.set(4, -2, 3); scene.add(fill);
    const rim = new THREE.PointLight(0x60d8c8, 10, 14); rim.position.set(3, 1.5, -2.5); scene.add(rim);

    group.rotation.z = 0.35; group.rotation.x = 0.15;

    const size = () => { const w = wrap.clientWidth, h = wrap.clientHeight; renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); };
    size(); addEventListener('resize', size);

    const target = { x: 0, y: 0 }, cur = { x: 0, y: 0 };
    if (fine) addEventListener('pointermove', (e) => { target.x = (e.clientX / innerWidth - 0.5) * 2; target.y = (e.clientY / innerHeight - 0.5) * 2; });
    let visible = true; new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(wrap);
    const timer = new THREE.Timer(); let frame = 0;
    let scrollT = 0, scrollCur = 0;
    const onScroll = () => { const span = 150; scrollT = Math.min(1, Math.max(0, scrollY / span)); };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
    const loop = () => {
      requestAnimationFrame(loop); if (!visible) return;
      if (!fine && (frame++ % 2)) return;
      timer.update(); const t = timer.getElapsed();
      cur.x += (target.x - cur.x) * 0.05; cur.y += (target.y - cur.y) * 0.05;
      if (!reduce) {
        group.rotation.y = -0.35 + Math.sin(t * 0.25) * 0.35 + cur.x * 0.35;
        group.rotation.x = 0.25 + cur.y * 0.2 + Math.sin(t * 0.4) * 0.06;
        group.rotation.z = -0.5 + Math.sin(t * 0.3) * 0.04;
        group.position.y = Math.sin(t * 0.8) * 0.08;
        helix.rotation.x = t * 0.8;
        (beadA as any).emissiveIntensity = 0.8 + Math.sin(t * 3) * 0.35;
      }
      // scroll-driven dispersion
      const dt = Math.min(0.1, timer.getDelta() || 0.016);
      scrollCur += (scrollT - scrollCur) * Math.min(1, dt * 11);
      const k = reduce ? 0 : ease(scrollCur);
      white.position.x = -k * 0.9; glass.position.x = k * 0.9; white.rotation.z = Math.PI / 2 + k * 0.35; glass.rotation.z = Math.PI / 2 - k * 0.35;
      glassMat.opacity = 0.85 * (1 - k * 0.7); whiteMat.opacity = 1 - k * 0.55; seamMat.opacity = 1 - k; seam.scale.setScalar(1 + k * 1.8);
      for (const b of beads) { const u = (b as any).userData; b.position.copy(u.rest).addScaledVector(u.burst, k); b.rotation.x = u.spin.x * k * 6; b.rotation.y = u.spin.y * k * 6; b.scale.setScalar(1 + k * 0.9); }
      for (const l of links) { const m = l.material as THREE.Material; m.transparent = true; m.opacity = 0.9 * Math.max(0, 1 - k * 2.2); }
      const arr = burstGeo.attributes.position.array as Float32Array;
      const kk = Math.pow(k, 0.7);
      for (let i = 0; i < BC; i++) { const v = bdir[i]; arr[i * 3] = v.x * kk; arr[i * 3 + 1] = v.y * kk + Math.sin(t * 1.5 + i) * 0.04 * k; arr[i * 3 + 2] = v.z * kk; }
      burstGeo.attributes.position.needsUpdate = true; burstMat.opacity = Math.min(1, k * 1.6) * Math.max(0, 1 - Math.pow(k, 3) * 0.35);
      group.scale.setScalar(1.15 - k * 0.38);
      renderer.render(scene, camera);
    };
    loop();
    canvas.classList.add('is-on');
  }
  try {
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 900 }); else setTimeout(start, 200);
  } catch (e) { console.warn('peptide hero fallback', e); }
</script>
