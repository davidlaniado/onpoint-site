---
import { href } from '../lib/site';
interface Props { title?: string; lead?: string }
const { title = 'Ready to talk?', lead = 'Tell us who you are and what you are trying to grow. A real person replies, usually within one business day.' } = Astro.props;
---
<section class="container-x">
  <div class="reveal relative overflow-hidden rounded-3xl bg-navy text-white px-6 py-12 md:px-14 md:py-16">
    <div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-teal/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <h2 class="text-white text-3xl md:text-4xl font-extrabold">{title}</h2>
        <p class="mt-3 text-white/75 text-lg max-w-lg">{lead}</p>
      </div>
      <div class="flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
        <a href={href('/contact/?as=brand')} class="btn btn-teal">I am a brand</a>
        <a href={href('/contact/?as=partner')} class="btn bg-white/10 text-white border border-white/20 hover:bg-white/15">I am a media partner</a>
      </div>
    </div>
  </div>
</section>
