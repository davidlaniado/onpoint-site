---
import '../styles/pages.css';
import { href } from '../lib/site';
interface Props { title?: string; lead?: string }
const { title = 'Already past $1M? Let’s talk.', lead = 'Brands with a program that converts, and partners with verified traffic. A real person replies within one business day.' } = Astro.props;
const words = ['Verified', 'Tracked', 'Paid', 'Reviewed', 'Audited', 'Approved'];
const seq = [...words, ...words];
---
<section class="container-x">
  <div class="cta-band reveal relative overflow-hidden rounded-[28px] bg-navy-deep text-white px-6 py-16 md:px-16 md:py-24 isolate">
    <div class="cta-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="cta-blob cta-blob-a" aria-hidden="true"></div>
    <div class="cta-blob cta-blob-b" aria-hidden="true"></div>
    <div class="cta-marquee absolute inset-x-0 top-1/2 -translate-y-1/2 pointer-events-none select-none" aria-hidden="true">
      <div class="track">{seq.map((w) => <span>{w}<i>·</i></span>)}</div>
    </div>
    <div class="relative grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <p class="eyebrow !text-teal">Next step</p>
        <h2 class="mt-4 text-white text-[34px] md:text-[52px] leading-[1.05] font-extrabold" data-split>{title}</h2>
        <p class="mt-4 text-white/75 text-lg md:text-xl max-w-lg leading-relaxed">{lead}</p>
      </div>
      <div class="flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
        <a href={href('/contact/?as=brand')} class="btn btn-teal !py-4 !px-7 text-base">I am a brand</a>
        <a href={href('/contact/?as=partner')} class="btn !py-4 !px-7 text-base bg-white/10 text-white border border-white/20 hover:bg-white/15">I am a media partner</a>
      </div>
    </div>
  </div>
</section>
