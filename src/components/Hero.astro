---
import Pipeline from './Pipeline.astro';
import { href } from '../lib/site';
---
<section class="relative overflow-hidden">
  <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
  <div class="container-x relative pt-14 pb-10 md:pt-24 md:pb-16 grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow">Performance network for regulated health</p>
      <h1 class="mt-5 text-[38px] leading-[1.06] sm:text-[48px] lg:text-[58px] font-extrabold">
        Compliant scale for <span class="text-teal-ink">telehealth</span> brands.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-slate max-w-xl leading-relaxed">
        Verified partners. Clear tracking. Payouts you can audit. OnPoint connects health brands with media partners who play by the rules, and gives both sides the numbers to prove it.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={href('/brands/')} class="btn btn-primary">For brands <span aria-hidden="true">→</span></a>
        <a href={href('/partners/')} class="btn btn-ghost">For media partners <span aria-hidden="true">→</span></a>
      </div>
      <p class="mt-5 text-sm text-mist">Not an open network. Every brand and partner is verified before anything goes live.</p>
    </div>
    <div class="lg:pl-4 min-w-0"><Pipeline /></div>
  </div>
</section>
