---
import { SITE, NAV, href } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-paper mt-24">
  <div class="container-x py-12 md:py-16 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <img src={href('/img/logo.png')} srcset={`${href('/img/logo-2x.png')} 2x`} alt="OnPoint Health Media & Tech" class="h-8 w-auto" width="720" height="195" loading="lazy" />
      <p class="mt-4 text-[15px] text-slate max-w-sm leading-relaxed">A verified performance network for telehealth, wellness, and diagnostics brands. Built for regulated health categories.</p>
      <p class="mt-4 text-sm text-mist">{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postal}</p>
    </div>
    <div>
      <p class="mono-label mb-3">Company</p>
      <ul class="space-y-2 text-[15px] text-navy">
        {NAV.map((n) => <li><a class="hover:text-teal-ink" href={href(n.path)}>{n.label}</a></li>)}
        <li><a class="hover:text-teal-ink" href={href('/contact/')}>Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="mono-label mb-3">Get started</p>
      <ul class="space-y-2 text-[15px] text-navy">
        <li><a class="hover:text-teal-ink" href={href('/contact/?as=brand')}>Apply as a brand</a></li>
        <li><a class="hover:text-teal-ink" href={href('/contact/?as=partner')}>Apply as a partner</a></li>
        <li><a class="hover:text-teal-ink" href={href('/careers/')}>Open roles</a></li>
        <li><a class="hover:text-teal-ink" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
      </ul>
    </div>
    <div>
      <p class="mono-label mb-3">Legal</p>
      <ul class="space-y-2 text-[15px] text-navy">
        <li><a class="hover:text-teal-ink" href={href('/terms/')}>Terms of Use</a></li>
        <li><a class="hover:text-teal-ink" href={href('/privacy/')}>Privacy Policy</a></li>
        <li><a class="hover:text-teal-ink" href={`mailto:${SITE.legalEmail}`}>{SITE.legalEmail}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x py-5 flex flex-col md:flex-row gap-2 md:items-center md:justify-between text-xs text-mist">
      <p>© {year} {SITE.legalName} All rights reserved.</p>
      <p>OnPoint is a marketing platform, not a medical provider. We do not provide medical advice, diagnosis, or treatment.</p>
    </div>
  </div>
</footer>
