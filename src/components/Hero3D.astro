---
// Live 3D hero: frosted glass stack + navy sphere (brand style), orbited by the pipeline nodes.
import { href } from '../lib/site';
const nodes = [
  ['brand', 'BRAND', 'applies'],
  ['review', 'REVIEW', 'kyc · claims · tracking'],
  ['partner', 'PARTNER', 'verified traffic'],
  ['convert', 'CONVERSION', 'postback logged'],
  ['payout', 'PAYOUT', 'approved · audited'],
];
const logs = [
  'brand.verified → business + kyc cleared',
  'claims.reviewed → advertiser owns approval',
  'tracking.live → s2s postback confirmed',
  'partner.approved → channel + placement ok',
  'conversion.logged → attributed end to end',
  'payout.cleared → on approved performance',
  'report.delivered → data back to the brand',
];
---
<div class="hero3d relative select-none" data-hero style="opacity:0;transform:translateY(24px)">
  <div class="hero3d-glow" aria-hidden="true"></div>
  <div class="hero3d-stage relative aspect-square max-w-[560px] mx-auto">
    <canvas id="hero3d-canvas" class="absolute inset-0 w-full h-full block" aria-label="Animated 3D object in OnPoint brand style"></canvas>
    <img id="hero3d-fallback" src={href('/img/photos/brands-hero.webp')} alt="" class="absolute inset-0 w-full h-full object-contain hidden" />
    <div class="hero3d-ring" aria-hidden="true"></div>
    {nodes.map(([id, label, sub], i) => (
      <div class="orbit-chip" data-chip={i} data-id={id}>
        <span class="dot"></span>
        <span class="lbl">{label}</span>
        <span class="sub">{sub}</span>
      </div>
    ))}
  </div>
  <div class="mt-2 mx-auto max-w-[560px] flex items-center justify-between gap-3 px-1">
    <span class="font-mono text-[11px] text-slate truncate min-w-0 flex-1" data-type-lines={JSON.stringify(logs)}>{logs[0]}</span>
    <span class="font-mono text-[11px] text-teal-ink whitespace-nowrap flex items-center gap-2"><span class="inline-block w-1.5 h-1.5 rounded-full bg-teal live-dot"></span>live</span>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const stage = document.querySelector<HTMLElement>('.hero3d-stage');
  const canvas = document.getElementById('hero3d-canvas') as HTMLCanvasElement | null;
  const fallback = document.getElementById('hero3d-fallback') as HTMLImageElement | null;
  const chips = [...document.querySelectorAll<HTMLElement>('.orbit-chip')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;

  // show the static render until the live scene has painted its first frame
  fallback?.classList.remove('hidden');

  function orbit(t: number) {
    // chips orbit on an ellipse around the object; depth (sin) drives scale + z-order
    const w = stage!.clientWidth, h = stage!.clientHeight;
    const cx = w / 2, cy = h / 2, rx = w * 0.5, ry = h * 0.2, yOff = h * 0.1;
    chips.forEach((c, i) => {
      const a = t * 0.35 + (i / chips.length) * Math.PI * 2;
      const x = cx + rx * Math.cos(a);
      const depth = Math.sin(a); // -1 back, +1 front
      const y = cy + yOff + ry * depth;
      const s = 0.76 + 0.24 * (depth + 1) / 2;
      c.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) scale(${s})`;
      c.style.zIndex = String(depth > 0 ? 3 : 1);
      c.style.opacity = String(0.5 + 0.5 * (depth + 1) / 2);
    });
  }

  // active chip cycles like the pipeline
  let active = 0;
  const cycle = () => { chips.forEach((c, i) => c.classList.toggle('active', i === active)); active = (active + 1) % chips.length; };
  cycle(); if (!reduce) setInterval(cycle, 1400);
  orbit(0);

  function frostedGlass(top: number, side: number, opacity = 0.96) {
    const m = new THREE.MeshPhysicalMaterial({
      color: 0xffffff, roughness: 0.58, metalness: 0, clearcoat: 0.45, clearcoatRoughness: 0.5,
      transparent: true, opacity, envMapIntensity: 0.45,
    });
    // tint faces by world-space normal: tops stay milky white, sides pick up the teal edge glow
    m.onBeforeCompile = (shader) => {
      shader.uniforms.uTop = { value: new THREE.Color(top) };
      shader.uniforms.uSide = { value: new THREE.Color(side) };
      shader.vertexShader = shader.vertexShader
        .replace('#include <common>', '#include <common>\nvarying vec3 vWN;')
        .replace('#include <defaultnormal_vertex>', '#include <defaultnormal_vertex>\nvWN = normalize(mat3(modelMatrix) * objectNormal);');
      shader.fragmentShader = shader.fragmentShader
        .replace('#include <common>', '#include <common>\nvarying vec3 vWN;\nuniform vec3 uTop;\nuniform vec3 uSide;')
        .replace('#include <color_fragment>', `#include <color_fragment>
          float up = smoothstep(0.4, 0.85, abs(vWN.y));
          float down = smoothstep(-0.4, -0.9, vWN.y);
          diffuseColor.rgb *= mix(uSide, uTop, up) * (1.0 - down * 0.18);
          float fr = pow(1.0 - clamp(dot(normalize(vViewPosition), normalize(vNormal)), 0.0, 1.0), 2.5);
          diffuseColor.rgb += fr * 0.10;`);
    };
    return m;
  }

  function contactShadowTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 256;
    const g = c.getContext('2d')!;
    const grd = g.createRadialGradient(128, 128, 10, 128, 128, 128);
    grd.addColorStop(0, 'rgba(24,40,88,0.28)'); grd.addColorStop(0.55, 'rgba(24,40,88,0.10)'); grd.addColorStop(1, 'rgba(24,40,88,0)');
    g.fillStyle = grd; g.fillRect(0, 0, 256, 256);
    const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
  }

  let ok = false;
  function start() {
    try {
      if (!canvas || !stage) throw new Error('no canvas');
      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(devicePixelRatio, fine ? 2 : 1.5));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFShadowMap;
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 1.7, 10.8);
      camera.lookAt(0, 0.05, 0);
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

      const group = new THREE.Group();
      scene.add(group);

      // frosted slab stack
      const slabGeo = new RoundedBoxGeometry(3.0, 0.38, 2.1, 5, 0.1);
      const slabs: THREE.Mesh[] = [];
      const baseY = -1.3, gap = 0.66;
      for (let i = 0; i < 5; i++) {
        const isTop = i === 4;
        const m = frostedGlass(isTop ? 0xf8fbfc : 0xf1f7f8, i % 2 === 1 ? 0x55c9ba : 0x7fd6ca, isTop ? 0.985 : 0.96);
        const mesh = new THREE.Mesh(slabGeo, m);
        mesh.position.y = baseY + i * gap;
        mesh.castShadow = true; mesh.receiveShadow = true;
        group.add(mesh); slabs.push(mesh);
      }
      const groundY = baseY - 0.19;
      // navy sphere on top
      const topY = baseY + 4 * gap + 0.19;
      const navy = new THREE.Mesh(new THREE.SphereGeometry(0.5, 64, 64), new THREE.MeshStandardMaterial({ color: 0x182858, roughness: 0.62, metalness: 0.02, envMapIntensity: 0.6 }));
      navy.position.set(0.2, topY + 0.5, 0.05); navy.castShadow = true; group.add(navy);
      // white sphere resting on the ground beside the stack
      const white = new THREE.Mesh(new THREE.SphereGeometry(0.38, 64, 64), new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.7, envMapIntensity: 0.5 }));
      white.position.set(-2.0, groundY + 0.38, 0.95); white.castShadow = true; group.add(white);
      // teal glass sphere floating
      const teal = new THREE.Mesh(new THREE.SphereGeometry(0.22, 48, 48), new THREE.MeshPhysicalMaterial({ color: 0x60d8c8, roughness: 0.35, clearcoat: 0.8, transparent: true, opacity: 0.88, envMapIntensity: 0.9 }));
      teal.position.set(1.95, -0.05, 0.85); group.add(teal);
      // ground: real shadow catcher + soft radial contact shadow
      const ground = new THREE.Mesh(new THREE.PlaneGeometry(14, 14), new THREE.ShadowMaterial({ opacity: 0.16 }));
      ground.rotation.x = -Math.PI / 2; ground.position.y = groundY; ground.receiveShadow = true; group.add(ground);
      const contact = new THREE.Mesh(new THREE.PlaneGeometry(6.2, 4.6), new THREE.MeshBasicMaterial({ map: contactShadowTexture(), transparent: true, depthWrite: false }));
      contact.rotation.x = -Math.PI / 2; contact.position.set(0.15, groundY + 0.005, 0.1); group.add(contact);
      group.rotation.y = -0.5;

      // lighting: soft sky, warm key with shadows, cool teal rim
      scene.add(new THREE.HemisphereLight(0xffffff, 0xe6edf6, 0.75));
      const key = new THREE.DirectionalLight(0xfff7ee, 1.9);
      key.position.set(-4.5, 7.5, 5.5); key.castShadow = true;
      key.shadow.mapSize.set(fine ? 1024 : 512, fine ? 1024 : 512);
      key.shadow.camera.left = -5; key.shadow.camera.right = 5; key.shadow.camera.top = 5; key.shadow.camera.bottom = -5;
      key.shadow.camera.near = 1; key.shadow.camera.far = 25; key.shadow.radius = 4; key.shadow.bias = -0.0005;
      scene.add(key);
      const rim = new THREE.DirectionalLight(0x60d8c8, 0.9); rim.position.set(5, 2.5, -5); scene.add(rim);
      const fill = new THREE.DirectionalLight(0xdfe9ff, 0.35); fill.position.set(4, 1, 6); scene.add(fill);

      const size = () => { const w = stage.clientWidth, h = stage.clientHeight; renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); };
      size(); addEventListener('resize', size);

      const target = { x: 0, y: 0 }; const cur = { x: 0, y: 0 };
      if (fine) addEventListener('pointermove', (e) => { target.x = (e.clientX / innerWidth - 0.5) * 2; target.y = (e.clientY / innerHeight - 0.5) * 2; });
      else addEventListener('scroll', () => { target.y = Math.min(1, scrollY / 600); }, { passive: true });

      let visible = true;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);

      const timer = new THREE.Timer();
      let frame = 0, painted = false;
      const loop = (ts: number) => {
        requestAnimationFrame(loop);
        frame++;
        if (!visible) return;
        if (!fine && frame % 2) return; // half-rate on phones
        timer.update(ts);
        const t = timer.getElapsed();
        cur.x += (target.x - cur.x) * 0.05; cur.y += (target.y - cur.y) * 0.05;
        if (!reduce) {
          group.rotation.y = -0.5 + t * 0.11 + cur.x * 0.35;
          group.rotation.x = cur.y * 0.12;
          slabs.forEach((s, i) => { s.position.y = baseY + i * gap + Math.sin(t * 1.1 + i * 0.7) * 0.035; });
          navy.position.y = topY + 0.5 + Math.sin(t * 1.3) * 0.06;
          teal.position.y = -0.05 + Math.cos(t * 0.9) * 0.14;
          orbit(t);
        }
        renderer.render(scene, camera);
        if (!painted) { painted = true; fallback?.classList.add('hidden'); canvas.classList.add('is-live'); }
      };
      requestAnimationFrame(loop); ok = true;
    } catch (err) {
      console.warn('hero3d fallback', err);
    }
    if (!ok) { canvas?.classList.add('hidden'); fallback?.classList.remove('hidden'); chips.forEach((c) => (c.style.display = 'none')); }
  }
  // lazy start: let the page paint first
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 900 });
  else setTimeout(start, 150);
</script>
